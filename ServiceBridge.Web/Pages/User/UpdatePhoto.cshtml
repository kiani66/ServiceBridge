@page
@model ServiceBridge.Web.Pages.User.UpdatePhotoModel
@{
    ViewData["Title"] = "Update Photo";
}

<div class="pb-auth-page">
    <div class="pb-auth-card">
        <div class="text-center">
            <div class="pb-logo-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#5A32B7" viewBox="0 0 16 16">
                    <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                    <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"/>
                </svg>
            </div>
            <h2>Update Photo</h2>
            <p class="pb-subtitle">Change your profile picture</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Current photo preview -->
        @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
        {
            <div class="text-center mb-3">
                <p class="form-label">Current Photo</p>
                <div class="pb-profile-avatar mx-auto" style="width: 80px; height: 80px;">
                    <img src="@Model.CurrentPhotoUrl" alt="Current photo" />
                </div>
            </div>
        }

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.ProfileImageUrl" class="form-label">Photo URL</label>
                <input asp-for="Input.ProfileImageUrl" class="form-control" placeholder="https://example.com/photo.jpg" />
                <span asp-validation-for="Input.ProfileImageUrl" class="text-danger"></span>
                <small class="text-muted">Enter a direct URL to your profile image.</small>
            </div>

            <!-- Live preview -->
            <div class="text-center mb-3" id="photoPreview" style="display: none;">
                <p class="form-label">Preview</p>
                <div class="pb-profile-avatar mx-auto" style="width: 80px; height: 80px;">
                    <img id="previewImage" src="" alt="Preview" />
                </div>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-pb-primary">Update Photo</button>
            </div>

            <div class="text-center">
                <a asp-page="/User/UserProfile" class="text-decoration-none" style="color: var(--pb-primary); font-weight: 600;">
                    &larr; Back to Profile
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const urlInput = document.getElementById('Input_ProfileImageUrl');
        const previewDiv = document.getElementById('photoPreview');
        const previewImg = document.getElementById('previewImage');

        if (urlInput) {
            urlInput.addEventListener('input', function () {
                const url = this.value.trim();
                if (url) {
                    previewImg.src = url;
                    previewDiv.style.display = 'block';
                    previewImg.onerror = function () {
                        previewDiv.style.display = 'none';
                    };
                } else {
                    previewDiv.style.display = 'none';
                }
            });
        }
    </script>
}
