@{
    var statusMessage = TempData["StatusMessage"]?.ToString();
    var toastTone = statusMessage?.StartsWith("Error", StringComparison.OrdinalIgnoreCase) == true
        ? "danger"
        : "success";
    var pageTitle = ViewData["Title"]?.ToString() ?? "ServiceBridge";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var fullName = User.FindFirst("FullName")?.Value;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - ServiceBridge</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sb-public-page-body">
    <header class="sb-legacy-topbar">
        <a class="sb-public-brand" href="/ui" aria-label="ServiceBridge home">
            <span class="sb-public-brand-mark">SB</span>
            <span>ServiceBridge</span>
        </a>
        <nav class="sb-legacy-nav" aria-label="Primary navigation">
            <a href="/ui/catalog">Services</a>
            <a href="/ui#about">How it works</a>
            <a href="/ui#faq">FAQ</a>
            <a href="/ui#contact">Contact</a>
        </nav>
        <div class="sb-legacy-actions">
            @if (isAuthenticated)
            {
                var landingPage = ServiceBridge.Web.Navigation.RoleNavigation.GetConsoleLandingPage(User) ?? "/ui";
                <span class="sb-account-chip" title="@fullName">
                    @(string.IsNullOrWhiteSpace(fullName) ? "Account" : fullName)
                </span>
                <a class="btn btn-outline-primary btn-sm" href="@landingPage">Workspace</a>
                <form method="post" asp-page="/Account/Logout" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                </form>
            }
            else
            {
                <a class="btn btn-link btn-sm" asp-page="/Account/Login">Login</a>
                <a class="btn btn-pb-primary btn-sm" asp-page="/Account/Register">Register</a>
            }
        </div>
    </header>

    <main role="main" class="sb-legacy-main">
        @RenderBody()
    </main>

    <footer class="pb-footer border-top">
        <div class="container">&copy; @DateTime.UtcNow.Year ServiceBridge</div>
    </footer>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div class="toast sb-toast text-bg-@toastTone border-0" role="status" aria-live="polite" aria-atomic="true" data-sb-toast>
                <div class="d-flex">
                    <div class="toast-body">@statusMessage</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="sb-confirmation-modal" tabindex="-1" aria-labelledby="sb-confirmation-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content sb-confirmation-modal">
                <div class="modal-header">
                    <h2 class="modal-title" id="sb-confirmation-title">Confirm action</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"><p id="sb-confirmation-message">Confirm that you want to continue.</p></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-pb-primary" id="sb-confirmation-continue">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
