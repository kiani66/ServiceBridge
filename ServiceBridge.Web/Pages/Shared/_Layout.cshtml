@{
    var requestPath = Context.Request.Path;
    var pathValue = requestPath.Value ?? "/";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isPublicPath =
        pathValue.Equals("/", StringComparison.OrdinalIgnoreCase) ||
        pathValue.Equals("/Index", StringComparison.OrdinalIgnoreCase) ||
        requestPath.StartsWithSegments("/Account") ||
        requestPath.StartsWithSegments("/Services") ||
        requestPath.StartsWithSegments("/Error");
    var useDashboardShell = isAuthenticated && !isPublicPath;
    var statusMessage = TempData["StatusMessage"]?.ToString();
    var toastTone = statusMessage?.StartsWith("Error", StringComparison.OrdinalIgnoreCase) == true
        ? "danger"
        : "success";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var fullName = User.FindFirst("FullName")?.Value;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - ServiceBridge</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(useDashboardShell ? "sb-razor-dashboard-body" : "sb-public-page-body")">
    @if (useDashboardShell)
    {
        <div class="sb-razor-shell">
            <aside class="sb-razor-sidebar" id="sb-razor-sidebar" aria-label="Dashboard navigation">
                <div class="sb-sidebar-header">
                    <div class="sb-brand-mark">SB</div>
                    <div>
                        <strong>ServiceBridge</strong>
                        <span>Service operations</span>
                    </div>
                </div>
                <nav class="sb-razor-nav">
                    @foreach (var item in ServiceBridge.Web.Navigation.RoleNavigation.GetItems(User))
                    {
                        var itemPath = item.Page.Split('?', 2)[0];
                        var isActive = pathValue.StartsWith(itemPath, StringComparison.OrdinalIgnoreCase);
                        <a class="sb-razor-nav-link @(isActive ? "active" : null)" href="@item.Page">@item.Text</a>
                    }
                </nav>
            </aside>

            <div class="sb-razor-workspace">
                <header class="sb-razor-topbar">
                    <button class="sb-icon-button" type="button" data-sidebar-toggle aria-label="Toggle navigation">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <div>
                        <span class="sb-topbar-context">Dashboard</span>
                        <strong>@pageTitle</strong>
                    </div>
                    <div class="sb-razor-topbar-spacer"></div>
                    <form class="sb-razor-search" role="search">
                        <label class="visually-hidden" for="sb-dashboard-search">Search</label>
                        <input id="sb-dashboard-search" class="form-control" type="search" placeholder="Search services or orders" />
                    </form>
                    @if (User.IsInRole(ServiceBridge.Shared.Constants.AppConstants.Roles.User))
                    {
                        <a class="btn btn-pb-primary btn-sm" href="/ui/catalog">New order</a>
                    }
                    <div class="sb-account-chip" title="@fullName">
                        @(string.IsNullOrWhiteSpace(fullName) ? "Account" : fullName)
                    </div>
                    <form method="post" asp-page="/Account/Logout" class="m-0">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                    </form>
                </header>

                <main role="main" class="sb-razor-main">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm sb-public-navbar border-bottom">
                <div class="container">
                    <a class="navbar-brand" asp-page="/Index">ServiceBridge</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link" href="/ui/catalog">Services</a></li>
                            <li class="nav-item"><a class="nav-link" href="/ui#faq">FAQ</a></li>
                            <li class="nav-item"><a class="nav-link" href="/ui#contact">Contact Us</a></li>
                            <li class="nav-item"><a class="nav-link" href="/ui#about">About</a></li>
                        </ul>
                        <ul class="navbar-nav">
                            @if (isAuthenticated)
                            {
                                var landingPage = ServiceBridge.Web.Navigation.RoleNavigation.GetLandingPage(User) ?? "/ui";
                                <li class="nav-item"><a class="nav-link" href="@landingPage">Workspace</a></li>
                                <li class="nav-item">
                                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                                        <button type="submit" class="btn btn-outline-primary btn-sm ms-2">Logout</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Login</a></li>
                                <li class="nav-item"><a class="btn btn-pb-primary btn-sm ms-2" asp-page="/Account/Register">Register</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer class="pb-footer border-top">
            <div class="container">
                &copy; @DateTime.UtcNow.Year ServiceBridge
            </div>
        </footer>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div class="toast sb-toast text-bg-@toastTone border-0" role="status" aria-live="polite" aria-atomic="true" data-sb-toast>
                <div class="d-flex">
                    <div class="toast-body">@statusMessage</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="sb-confirmation-modal" tabindex="-1" aria-labelledby="sb-confirmation-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content sb-confirmation-modal">
                <div class="modal-header">
                    <h2 class="modal-title" id="sb-confirmation-title">Confirm action</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="sb-confirmation-message">Confirm that you want to continue.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-pb-primary" id="sb-confirmation-continue">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
