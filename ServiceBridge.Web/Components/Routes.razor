<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized Context="authState">
                @if (authState.User.Identity?.IsAuthenticated == true)
                {
                    <LayoutView Layout="@typeof(MainLayout)">
                        <EmptyState Title="Access denied"
                                    Description="Your account does not have access to this dashboard page."
                                    Icon="@Icons.Material.Outlined.Lock" />
                    </LayoutView>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(PublicLayout)">
            <EmptyState Title="Page not found"
                        Description="The requested Blazor page is not available yet." />
        </LayoutView>
    </NotFound>
</Router>

