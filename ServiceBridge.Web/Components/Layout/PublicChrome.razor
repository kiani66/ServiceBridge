<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<main class="sb-public-shell">
    <header class="sb-public-topbar">
        <a class="sb-public-brand" href="/ui" aria-label="ServiceBridge home">
            <span class="sb-public-brand-mark">SB</span>
            <span>ServiceBridge</span>
        </a>
        <nav class="sb-public-nav" aria-label="Public navigation">
            <a href="/ui/catalog">Services</a>
            <a href="/ui#about">How it works</a>
            <a href="/ui#faq">FAQ</a>
            <a href="/ui#contact">Contact Us</a>
        </nav>
        <div class="sb-public-actions">
            <MudButton Href="/Account/Login" Variant="Variant.Text" Color="Color.Primary">
                Login
            </MudButton>
            <MudButton Href="/Account/Register" Variant="Variant.Filled" Color="Color.Primary">
                Register
            </MudButton>
        </div>
    </header>

    @ChildContent
</main>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#F97316",
            Secondary = "#2563EB",
            Background = "#F6F8FB",
            Surface = "#FFFFFF",
            TextPrimary = "#111827",
            TextSecondary = "#5B6472",
            LinesDefault = "#E5E7EB"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        }
    };
}
