@page "/ui/catalog"
@layout PublicLayout
@inject PublicCatalogClient CatalogClient

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Catalog", null) })" />

<PageHeader Eyebrow="Catalog"
            Title="Digital services"
            Description="Select an active provider-backed service, compare live IRR pricing, and review fulfillment context before checkout.">
    <Actions>
        <MudButton Href="/ui" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Home">
            Home
        </MudButton>
    </Actions>
</PageHeader>

<PageSection MaxWidth="standard">
    <DataGridToolbar Title="Service catalog"
                     Description="Search and narrow active services by category or provider."
                     Search="@_search"
                     SearchChanged="OnSearchChanged"
                     SearchPlaceholder="Search by service, provider, or category">
        <Actions>
            <MudSelect T="string" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@_categoryFilter" ValueChanged="OnCategoryChanged" Class="sb-filter-control">
                <MudSelectItem T="string" Value="@string.Empty">All categories</MudSelectItem>
                @foreach (var category in CategoryOptions)
                {
                    <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Provider" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@_providerFilter" ValueChanged="OnProviderChanged" Class="sb-filter-control">
                <MudSelectItem T="string" Value="@string.Empty">All providers</MudSelectItem>
                @foreach (var provider in ProviderOptions)
                {
                    <MudSelectItem T="string" Value="@provider">@provider</MudSelectItem>
                }
            </MudSelect>
            @if (HasFilters)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FilterAltOff" OnClick="ClearFilters">
                    Clear
                </MudButton>
            }
        </Actions>
    </DataGridToolbar>

    @if (_loading)
    {
        <LoadingSkeleton Lines="6" Label="Loading active services" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="Unable to load services"
                    Message="@_errorMessage"
                    Icon="@Icons.Material.Outlined.CloudOff"
                    OnRetry="LoadAsync" />
    }
    else if (_services.Count == 0)
    {
        <EmptyState Title="No active services"
                    Description="The public catalog has no active services available."
                    Icon="@Icons.Material.Outlined.Inventory2" />
    }
    else if (FilteredServiceList.Count == 0)
    {
        <EmptyState Title="No matching services"
                    Description="Adjust the search text to find another service or provider."
                    Icon="@Icons.Material.Outlined.SearchOff" />
    }
    else
    {
        <div class="sb-result-summary" aria-live="polite">
            <strong>@FilteredServiceList.Count</strong>
            <span>@(FilteredServiceList.Count == 1 ? "service" : "services") found</span>
        </div>
        <div class="sb-service-grid">
            @foreach (var service in FilteredServiceList)
            {
                <ServiceCard Service="@service" />
            }
        </div>
    }
</PageSection>

<PageSection Title="Browse by category" Description="Categories are derived from active public services." MaxWidth="standard">
    @if (_loading)
    {
        <LoadingSkeleton Lines="3" Label="Loading categories" />
    }
    else if (_categories.Count == 0)
    {
        <EmptyState Title="No active categories"
                    Description="Categories appear when active services are published."
                    Icon="@Icons.Material.Outlined.Category" />
    }
    else
    {
        <div class="sb-category-grid">
            @foreach (var category in _categories)
            {
                <a class="sb-category-card" href="@($"/ui/catalog/{category.Slug}")">
                    <MudIcon Icon="@Icons.Material.Outlined.Category" Size="Size.Large" />
                    <strong>@category.Name</strong>
                    <span>@category.Description</span>
                </a>
            }
        </div>
    }
</PageSection>

@code {
    private string? _search;
    private string _categoryFilter = string.Empty;
    private string _providerFilter = string.Empty;
    private bool _loading = true;
    private string? _errorMessage;
    private IReadOnlyList<PublicCatalogCategory> _categories = [];
    private IReadOnlyList<PublicCatalogService> _services = [];

    private IReadOnlyList<string> CategoryOptions => _services
        .Select(service => service.CategoryName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(name => name)
        .ToArray();

    private IReadOnlyList<string> ProviderOptions => _services
        .Select(service => service.ProviderName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(name => name)
        .ToArray();

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        !string.IsNullOrWhiteSpace(_categoryFilter) ||
        !string.IsNullOrWhiteSpace(_providerFilter);

    private IReadOnlyList<PublicCatalogService> FilteredServiceList
    {
        get
        {
            return _services
                .Where(service =>
                    string.IsNullOrWhiteSpace(_search) ||
                    service.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    service.ProviderName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    service.CategoryName.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .Where(service =>
                    string.IsNullOrWhiteSpace(_categoryFilter) ||
                    string.Equals(service.CategoryName, _categoryFilter, StringComparison.OrdinalIgnoreCase))
                .Where(service =>
                    string.IsNullOrWhiteSpace(_providerFilter) ||
                    string.Equals(service.ProviderName, _providerFilter, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        var result = await CatalogClient.GetCatalogAsync();
        if (result.Success)
        {
            _categories = result.Categories;
            _services = result.Services;
        }
        else
        {
            _categories = [];
            _services = [];
            _errorMessage = result.ErrorMessage ?? "Unable to load active services.";
        }

        _loading = false;
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return Task.CompletedTask;
    }

    private Task OnCategoryChanged(string value)
    {
        _categoryFilter = value;
        return Task.CompletedTask;
    }

    private Task OnProviderChanged(string value)
    {
        _providerFilter = value;
        return Task.CompletedTask;
    }

    private void ClearFilters()
    {
        _search = null;
        _categoryFilter = string.Empty;
        _providerFilter = string.Empty;
    }
}
