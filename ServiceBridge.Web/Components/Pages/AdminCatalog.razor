@page "/ui/admin/catalog"
@attribute [Authorize(Roles = AppConstants.Roles.Admin)]
@inject AdminCatalogClient AdminCatalogClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Admin", "/ui/admin"), ("Catalog", null) })" />

<PageHeader Eyebrow="Admin operations"
            Title="Service Catalog"
            Description="Manage categories and purchasable digital services without leaving the catalog workspace.">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   id="new-category-trigger"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                   OnClick="OpenCategoryDrawer">
            New category
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   id="new-service-trigger"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   Disabled="@(_loading || _categories.Count == 0)"
                   OnClick="OpenServiceDrawer">
            New service
        </MudButton>
    </Actions>
</PageHeader>

<PageSection MaxWidth="wide">
    @if (_loading)
    {
        <LoadingState Text="Loading catalog" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <ErrorState Title="Unable to load catalog"
                    Message="@_loadError"
                    OnRetry="LoadAsync" />
    }
    else
    {
        <div class="sb-stat-grid sb-stat-grid-compact">
            <StatCard Label="Categories" Value="@_categories.Count.ToString("N0")" Description="Catalog groupings" Tone="neutral" Icon="@Icons.Material.Outlined.Category" />
            <StatCard Label="Services" Value="@_services.Count.ToString("N0")" Description="All catalog records" Tone="info" Icon="@Icons.Material.Outlined.Inventory2" />
            <StatCard Label="Active services" Value="@_services.Count(service => service.IsActive).ToString("N0")" Description="Available for administration" Tone="success" Icon="@Icons.Material.Outlined.CheckCircle" />
        </div>
    }
</PageSection>

<PageSection MaxWidth="wide" Title="Services" Description="Current service catalog records.">
    @if (!_loading && string.IsNullOrWhiteSpace(_loadError))
    {
        @if (_services.Count == 0)
        {
            <EmptyState Title="No services" Description="Services will appear after they are created." Icon="@Icons.Material.Outlined.Inventory2" />
        }
        else
        {
            <MudTable Items="@_services" Hover="true" Dense="true" Class="sb-data-table">
                <HeaderContent>
                    <MudTh>Service</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>Price</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Service"><strong>@context.Name</strong><span class="sb-table-subtext">@context.Provider</span></MudTd>
                    <MudTd DataLabel="Category">@context.CategoryName</MudTd>
                    <MudTd DataLabel="Price">@context.BasePrice.ToString("0.####") @context.CurrencyCode</MudTd>
                    <MudTd DataLabel="Status"><StatusBadge Text="@(context.IsActive ? "Active" : "Inactive")" Tone="@(context.IsActive ? "success" : "neutral")" /></MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Href="@($"/ui/admin/catalog/services/{context.Id}")"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   EndIcon="@Icons.Material.Outlined.ArrowForward">
                            Manage
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</PageSection>

@if (_categoryDrawerOpen)
{
<Drawer Open="true" OnCloseRequested="CloseCategoryDrawer" Busy="@_actionBusy" ReturnFocusElementId="new-category-trigger" Title="Create category" Eyebrow="Catalog">
    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
    }
    <EditForm Model="_categoryRequest" OnValidSubmit="CreateCategoryAsync" class="sb-drawer-form">
        <DataAnnotationsValidator />
        <MudTextField T="string" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_categoryRequest.Name" />
        <MudTextField T="string" Label="Slug" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_categoryRequest.Slug" />
        <MudNumericField T="int" Label="Display order" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" @bind-Value="_categoryRequest.DisplayOrder" />
        <MudCheckBox T="bool" Label="Active" Color="Color.Primary" @bind-Value="_categoryRequest.IsActive" />
        <ValidationSummary />
        <div class="sb-drawer-actions">
            <MudButton Variant="Variant.Text" Disabled="@_actionBusy" OnClick="CloseCategoryDrawer">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_actionBusy">Create category</MudButton>
        </div>
    </EditForm>
</Drawer>
}

@if (_serviceDrawerOpen)
{
<Drawer Open="true" OnCloseRequested="CloseServiceDrawer" Busy="@_actionBusy" ReturnFocusElementId="new-service-trigger" Title="Create service" Eyebrow="Catalog">
    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
    }
    <EditForm Model="_serviceRequest" OnValidSubmit="CreateServiceAsync" class="sb-drawer-form">
        <DataAnnotationsValidator />
        <MudSelect T="Guid" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_serviceRequest.CategoryId">
            @foreach (var category in _categories)
            {
                <MudSelectItem T="Guid" Value="@category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_serviceRequest.Name" />
        <MudTextField T="string" Label="Provider" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_serviceRequest.Provider" />
        <MudTextField T="string" Label="Slug" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_serviceRequest.Slug" />
        <MudNumericField T="decimal" Label="Base price" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.0001m" @bind-Value="_serviceRequest.BasePrice" />
        <MudTextField T="string" Label="Currency" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_serviceRequest.CurrencyCode" />
        <MudTextField T="string" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" @bind-Value="_serviceRequest.Description" />
        <MudTextField T="string" Label="Processing time" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_serviceRequest.ProcessingTimeDescription" />
        <MudTextField T="string" Label="Logo URL" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_serviceRequest.LogoUrl" />
        <MudCheckBox T="bool" Label="Active" Color="Color.Primary" @bind-Value="_serviceRequest.IsActive" />
        <MudCheckBox T="bool" Label="Supports existing account" Color="Color.Primary" @bind-Value="_serviceRequest.SupportsUseExistingAccount" />
        <MudCheckBox T="bool" Label="Supports creating new account" Color="Color.Primary" @bind-Value="_serviceRequest.SupportsCreateNewAccount" />
        <ValidationSummary />
        <div class="sb-drawer-actions">
            <MudButton Variant="Variant.Text" Disabled="@_actionBusy" OnClick="CloseServiceDrawer">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_actionBusy">Create service</MudButton>
        </div>
    </EditForm>
</Drawer>
}

@code {
    private bool _loading = true;
    private bool _actionBusy;
    private bool _categoryDrawerOpen;
    private bool _serviceDrawerOpen;
    private string? _loadError;
    private string? _actionError;
    private IReadOnlyCollection<ServiceCategoryResponse> _categories = Array.Empty<ServiceCategoryResponse>();
    private IReadOnlyCollection<AdminServiceSummaryResponse> _services = Array.Empty<AdminServiceSummaryResponse>();
    private CreateServiceCategoryRequest _categoryRequest = new();
    private CreateDigitalServiceRequest _serviceRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        var result = await AdminCatalogClient.GetCatalogAsync();
        if (RedirectIfAuthRequired(result.RequiresAuthentication))
        {
            return;
        }

        if (result.Success && result.Data is not null)
        {
            _categories = result.Data.Categories.OrderBy(category => category.DisplayOrder).ThenBy(category => category.Name).ToArray();
            _services = result.Data.Services.OrderBy(service => service.CategoryName).ThenBy(service => service.Name).ToArray();
            if (_serviceRequest.CategoryId == Guid.Empty && _categories.Count > 0)
            {
                _serviceRequest.CategoryId = _categories.First().Id;
            }
        }
        else
        {
            _loadError = result.ErrorMessage;
        }

        _loading = false;
    }

    private Task CreateCategoryAsync()
    {
        if (_actionBusy) return Task.CompletedTask;

        return RunActionAsync(
            () => AdminCatalogClient.CreateCategoryAsync(_categoryRequest),
            () =>
            {
                _categoryRequest = new();
                CloseCategoryDrawer();
            },
            "Category created.");
    }

    private Task CreateServiceAsync()
    {
        if (_actionBusy) return Task.CompletedTask;

        return RunActionAsync(
            () => AdminCatalogClient.CreateServiceAsync(_serviceRequest),
            () =>
            {
                _serviceRequest = new CreateDigitalServiceRequest
                {
                    CategoryId = _categories.FirstOrDefault()?.Id ?? Guid.Empty
                };
                CloseServiceDrawer();
            },
            "Service created.");
    }

    private async Task RunActionAsync(
        Func<Task<AdminOrdersApiResult<bool>>> action,
        Action onSuccess,
        string successMessage)
    {
        if (_actionBusy)
        {
            return;
        }

        _actionBusy = true;
        try
        {
            _actionError = null;
            var result = await action();
            if (RedirectIfAuthRequired(result.RequiresAuthentication))
            {
                return;
            }

            if (result.Success)
            {
                onSuccess();
                await LoadAsync();
                Snackbar.Add(successMessage, Severity.Success);
            }
            else
            {
                _actionError = result.ErrorMessage ?? "Unable to save catalog changes.";
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private bool RedirectIfAuthRequired(bool requiresAuthentication)
    {
        if (!requiresAuthentication)
        {
            return false;
        }

        Navigation.NavigateTo("/Account/Login");
        return true;
    }

    private void OpenCategoryDrawer()
    {
        _actionError = null;
        _categoryDrawerOpen = true;
    }

    private void CloseCategoryDrawer()
    {
        _actionError = null;
        _categoryDrawerOpen = false;
    }

    private void OpenServiceDrawer()
    {
        _actionError = null;
        _serviceDrawerOpen = true;
    }

    private void CloseServiceDrawer()
    {
        _actionError = null;
        _serviceDrawerOpen = false;
    }
}
