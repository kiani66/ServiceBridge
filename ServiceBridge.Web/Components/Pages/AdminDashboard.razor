@page "/ui/admin"
@attribute [Authorize(Roles = AppConstants.Roles.Admin)]
@implements IDisposable
@inject AdminOrdersClient AdminOrdersClient
@inject OrderRealtimeClient OrderRealtimeClient
@inject NavigationManager Navigation

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Admin", null) })" />

<PageHeader Eyebrow="Admin operations"
            Title="Admin Dashboard"
            Description="Monitor ServiceBridge order flow, payment health, assignment pressure, and agent workload.">
    <Actions>
        <MudButton Href="/Admin/Orders"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.ReceiptLong">
            Manage Orders
        </MudButton>
    </Actions>
</PageHeader>

<PageSection MaxWidth="wide">
    @if (_summaryLoading)
    {
        <LoadingState Text="Loading admin dashboard" />
    }
    else if (!string.IsNullOrWhiteSpace(_summaryError))
    {
        <ErrorState Title="Unable to load admin dashboard"
                    Message="@_summaryError"
                    OnRetry="LoadSummaryAsync" />
    }
    else if (_summary is not null)
    {
        <div class="sb-stat-grid">
            <StatCard Label="Orders Today"
                      Value="@OrdersToday.ToString("N0")"
                      Description="From loaded recent orders"
                      Tone="neutral"
                      Icon="@Icons.Material.Outlined.Today" />
            <StatCard Label="Total Revenue IRR"
                      Value="@($"{TotalRevenueIrr:N0}")"
                      Description="Completed payments in loaded window"
                      Tone="success"
                      Icon="@Icons.Material.Outlined.AccountBalanceWallet" />
            <StatCard Label="Pending Assignment"
                      Value="@_summary.UnassignedOrderCount.ToString("N0")"
                      Description="Paid orders needing an agent"
                      Tone="warning"
                      Icon="@Icons.Material.Outlined.AssignmentLate" />
            <StatCard Label="Processing Orders"
                      Value="@_summary.ProcessingOrderCount.ToString("N0")"
                      Description="Currently in fulfillment"
                      Tone="info"
                      Icon="@Icons.Material.Outlined.ManageHistory" />
            <StatCard Label="Completed Orders"
                      Value="@_summary.CompletedOrderCount.ToString("N0")"
                      Description="Fulfilled service requests"
                      Tone="success"
                      Icon="@Icons.Material.Outlined.CheckCircle" />
            <StatCard Label="Failed Orders"
                      Value="@_summary.FailedOrderCount.ToString("N0")"
                      Description="Orders requiring review"
                      Tone="danger"
                      Icon="@Icons.Material.Outlined.ErrorOutline" />
        </div>
    }
</PageSection>

<PageSection MaxWidth="wide">
    <div class="sb-dashboard-grid sb-dashboard-grid-two">
        <section class="sb-dashboard-panel sb-chart-card">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Order Activity</h2>
                    <p>Operational order distribution from the current summary.</p>
                </div>
            </div>

            @if (_summary is null)
            {
                <EmptyState Title="Order activity unavailable"
                            Description="Summary data could not be loaded."
                            Icon="@Icons.Material.Outlined.Analytics" />
            }
            else
            {
                <div class="sb-chart-bars" aria-label="Order activity by status">
                    @foreach (var point in OrderActivity)
                    {
                        <div class="sb-chart-bar">
                            <span class="sb-chart-bar-fill" style="@($"height:{point.HeightPercent}%")"></span>
                            <span>@point.Label</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="sb-dashboard-panel sb-chart-card">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Completion Trend</h2>
                    <p>Daily completion trend requires a dedicated time-series endpoint.</p>
                </div>
            </div>
            <EmptyState Title="Trend data not exposed yet"
                        Description="The dashboard shell is ready; the current API exposes aggregate counts, not daily trend points."
                        Icon="@Icons.Material.Outlined.ShowChart" />
        </section>
    </div>
</PageSection>

<PageSection MaxWidth="wide">
    <div class="sb-dashboard-grid sb-dashboard-grid-two">
        <section class="sb-dashboard-panel">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Recent Orders</h2>
                    <p>Newest order activity across customers, payments, fulfillment, and assignment.</p>
                </div>
                <MudButton Href="/Admin/Orders"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Outlined.ArrowForward">
                    View All
                </MudButton>
            </div>

            @if (_ordersLoading)
            {
                <LoadingState Text="Loading recent orders" />
            }
            else if (!string.IsNullOrWhiteSpace(_ordersError))
            {
                <ErrorState Title="Unable to load recent orders"
                            Message="@_ordersError"
                            OnRetry="LoadOrdersAsync" />
            }
            else if (_orders.Items.Count == 0)
            {
                <EmptyState Title="No recent orders"
                            Description="Orders will appear after customer checkout."
                            Icon="@Icons.Material.Outlined.ReceiptLong" />
            }
            else
            {
                <MudTable Items="@_orders.Items" Hover="true" Dense="true" Class="sb-data-table">
                    <HeaderContent>
                        <MudTh>Order Number</MudTh>
                        <MudTh>Customer</MudTh>
                        <MudTh>Service</MudTh>
                        <MudTh>Payment Status</MudTh>
                        <MudTh>Order Status</MudTh>
                        <MudTh>Agent</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Order Number"><strong>@context.OrderNumber</strong></MudTd>
                        <MudTd DataLabel="Customer">@context.CustomerName<span class="sb-table-subtext">@context.CustomerEmail</span></MudTd>
                        <MudTd DataLabel="Service">@context.ServiceName</MudTd>
                        <MudTd DataLabel="Payment Status"><StatusBadge Text="@UserOrderDisplay.PaymentStatusLabel(context.PaymentStatus)" Tone="@UserOrderDisplay.PaymentTone(context.PaymentStatus)" /></MudTd>
                        <MudTd DataLabel="Order Status"><StatusBadge Text="@UserOrderDisplay.OrderStatusLabel(context.OrderStatus)" Tone="@UserOrderDisplay.OrderTone(context.OrderStatus)" /></MudTd>
                        <MudTd DataLabel="Agent">@(context.AssignedAgentName ?? "-")</MudTd>
                        <MudTd DataLabel="Action">
                            <MudButton Href="@($"/ui/admin/orders/{context.OrderId}")"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small">
                                Details
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </section>

        <section class="sb-dashboard-panel">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Agent Workload</h2>
                    <p>Active and assigned work by agent.</p>
                </div>
            </div>

            @if (_agentsLoading)
            {
                <LoadingState Text="Loading agents" />
            }
            else if (!string.IsNullOrWhiteSpace(_agentsError))
            {
                <ErrorState Title="Unable to load agents"
                            Message="@_agentsError"
                            OnRetry="LoadAgentsAsync" />
            }
            else if (_agents.Count == 0)
            {
                <EmptyState Title="No active agents"
                            Description="Active agents will appear here after setup."
                            Icon="@Icons.Material.Outlined.SupportAgent" />
            }
            else
            {
                <div class="sb-workload-list">
                    @foreach (var agent in _agents.OrderByDescending(agent => agent.ActiveOrderCount).Take(6))
                    {
                        <article class="sb-workload-item">
                            <div class="sb-workload-line">
                                <strong>@agent.FullName</strong>
                                <span>@agent.ActiveOrderCount active / @agent.AssignedOrderCount assigned</span>
                            </div>
                            <div class="sb-progress-track" aria-hidden="true">
                                <span class="sb-progress-fill" style="@($"width:{WorkloadPercent(agent)}%")"></span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</PageSection>

<PageSection MaxWidth="wide">
    <div class="sb-dashboard-grid sb-dashboard-grid-three">
        <section class="sb-dashboard-panel">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Top Services</h2>
                    <p>Most frequent services in the loaded recent order window.</p>
                </div>
            </div>

            @if (TopServices.Count == 0)
            {
                <EmptyState Title="No service usage yet"
                            Description="Top services will appear when orders are available."
                            Icon="@Icons.Material.Outlined.Apps" />
            }
            else
            {
                <div class="sb-service-rank-list">
                    @foreach (var service in TopServices)
                    {
                        <article class="sb-service-rank-item">
                            <div class="sb-service-rank-line">
                                <strong>@service.Name</strong>
                                <span>@service.Count orders</span>
                            </div>
                            <div class="sb-progress-track" aria-hidden="true">
                                <span class="sb-progress-fill" style="@($"width:{service.Percent}%")"></span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="sb-dashboard-panel">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Payment Health</h2>
                    <p>Recent payment records by status.</p>
                </div>
            </div>

            @if (_paymentsLoading)
            {
                <LoadingState Text="Loading payments" />
            }
            else if (!string.IsNullOrWhiteSpace(_paymentsError))
            {
                <ErrorState Title="Unable to load payments"
                            Message="@_paymentsError"
                            OnRetry="LoadPaymentsAsync" />
            }
            else if (_payments.Items.Count == 0)
            {
                <EmptyState Title="No payment records"
                            Description="Payment activity appears after checkout."
                            Icon="@Icons.Material.Outlined.Payments" />
            }
            else
            {
                <div class="sb-service-rank-list">
                    @foreach (var status in PaymentHealth)
                    {
                        <article class="sb-service-rank-item">
                            <div class="sb-service-rank-line">
                                <StatusBadge Text="@UserOrderDisplay.PaymentStatusLabel(status.Name)"
                                             Tone="@UserOrderDisplay.PaymentTone(status.Name)" />
                                <span>@status.Count</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="sb-dashboard-panel">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Operations Links</h2>
                    <p>Admin tools for daily platform operation.</p>
                </div>
            </div>
            <div class="sb-dashboard-actions">
                <div class="sb-dashboard-action-row">
                    <div>
                        <strong>Catalog</strong>
                        <span>Maintain digital services.</span>
                    </div>
                    <MudButton Href="/Admin/Catalog" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Open</MudButton>
                </div>
                <div class="sb-dashboard-action-row">
                    <div>
                        <strong>Pricing</strong>
                        <span>Manage service prices.</span>
                    </div>
                    <MudButton Href="/Admin/Pricing" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Open</MudButton>
                </div>
                <div class="sb-dashboard-action-row">
                    <div>
                        <strong>Users</strong>
                        <span>Manage customer and agent accounts.</span>
                    </div>
                    <MudButton Href="/Admin/Users" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Open</MudButton>
                </div>
            </div>
        </section>
    </div>
</PageSection>

@code {
    private const int PageSize = 12;

    private bool _summaryLoading = true;
    private bool _ordersLoading = true;
    private bool _agentsLoading = true;
    private bool _paymentsLoading = true;
    private string? _summaryError;
    private string? _ordersError;
    private string? _agentsError;
    private string? _paymentsError;
    private AdminOrderDashboardSummaryDto? _summary;
    private PagedResultDto<AdminOrderListItemDto> _orders = new();
    private PagedResultDto<AdminPaymentListItemDto> _payments = new();
    private IReadOnlyCollection<AgentSummaryDto> _agents = Array.Empty<AgentSummaryDto>();

    private int OrdersToday =>
        _orders.Items.Count(order => order.CreatedAt.Date == DateTime.UtcNow.Date);

    private decimal TotalRevenueIrr =>
        _payments.Items
            .Where(payment => payment.Status == nameof(PaymentStatus.Completed))
            .Sum(payment => payment.AmountIrr);

    private IReadOnlyList<ChartPoint> OrderActivity
    {
        get
        {
            if (_summary is null)
            {
                return Array.Empty<ChartPoint>();
            }

            var points = new[]
            {
                new ChartPoint("Waiting", _summary.PendingPaymentOrderCount),
                new ChartPoint("Paid", _summary.PaidOrderCount),
                new ChartPoint("Unassigned", _summary.UnassignedOrderCount),
                new ChartPoint("Processing", _summary.ProcessingOrderCount),
                new ChartPoint("Completed", _summary.CompletedOrderCount),
                new ChartPoint("Failed", _summary.FailedOrderCount)
            };
            var max = Math.Max(points.Max(point => point.Value), 1);

            return points
                .Select(point => point with
                {
                    HeightPercent = Math.Max(8, (int)Math.Round(point.Value * 100m / max))
                })
                .ToArray();
        }
    }

    private IReadOnlyList<ServiceRank> TopServices
    {
        get
        {
            var groups = _orders.Items
                .GroupBy(order => order.ServiceName)
                .Select(group => new { Name = group.Key, Count = group.Count() })
                .OrderByDescending(group => group.Count)
                .ThenBy(group => group.Name)
                .Take(5)
                .ToArray();
            var max = Math.Max(groups.Select(group => group.Count).DefaultIfEmpty(0).Max(), 1);

            return groups
                .Select(group => new ServiceRank(
                    group.Name,
                    group.Count,
                    Math.Max(8, (int)Math.Round(group.Count * 100m / max))))
                .ToArray();
        }
    }

    private IReadOnlyList<StatusCount> PaymentHealth =>
        _payments.Items
            .GroupBy(payment => payment.Status)
            .Select(group => new StatusCount(group.Key, group.Count()))
            .OrderByDescending(group => group.Count)
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        OrderRealtimeClient.OrderUpdated += HandleOrderUpdatedAsync;
        await OrderRealtimeClient.StartAsync();
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        await LoadSummaryAsync();
        await LoadOrdersAsync();
        await LoadAgentsAsync();
        await LoadPaymentsAsync();
    }

    private async Task LoadSummaryAsync()
    {
        _summaryLoading = true;
        _summaryError = null;

        var result = await AdminOrdersClient.GetDashboardSummaryAsync();
        if (RedirectIfAuthRequired(result.RequiresAuthentication))
        {
            return;
        }

        _summary = result.Success ? result.Data : null;
        _summaryError = result.ErrorMessage;
        _summaryLoading = false;
    }

    private async Task LoadOrdersAsync()
    {
        _ordersLoading = true;
        _ordersError = null;

        var result = await AdminOrdersClient.GetOrdersAsync(1, PageSize, null, null);
        if (RedirectIfAuthRequired(result.RequiresAuthentication))
        {
            return;
        }

        _orders = result.Success && result.Data is not null
            ? result.Data
            : new PagedResultDto<AdminOrderListItemDto>();
        _ordersError = result.ErrorMessage;
        _ordersLoading = false;
    }

    private async Task LoadAgentsAsync()
    {
        _agentsLoading = true;
        _agentsError = null;

        var result = await AdminOrdersClient.GetActiveAgentsAsync();
        if (RedirectIfAuthRequired(result.RequiresAuthentication))
        {
            return;
        }

        _agents = result.Success && result.Data is not null
            ? result.Data
            : Array.Empty<AgentSummaryDto>();
        _agentsError = result.ErrorMessage;
        _agentsLoading = false;
    }

    private async Task LoadPaymentsAsync()
    {
        _paymentsLoading = true;
        _paymentsError = null;

        var result = await AdminOrdersClient.GetPaymentsAsync(1, PageSize, null, null);
        if (RedirectIfAuthRequired(result.RequiresAuthentication))
        {
            return;
        }

        _payments = result.Success && result.Data is not null
            ? result.Data
            : new PagedResultDto<AdminPaymentListItemDto>();
        _paymentsError = result.ErrorMessage;
        _paymentsLoading = false;
    }

    private int WorkloadPercent(AgentSummaryDto agent)
    {
        var max = Math.Max(_agents.Select(item => item.ActiveOrderCount).DefaultIfEmpty(0).Max(), 1);
        return Math.Max(8, (int)Math.Round(agent.ActiveOrderCount * 100m / max));
    }

    private bool RedirectIfAuthRequired(bool requiresAuthentication)
    {
        if (!requiresAuthentication)
        {
            return false;
        }

        Navigation.NavigateTo("/Account/Login");
        return true;
    }

    private Task HandleOrderUpdatedAsync(OrderUpdatedRealtimeMessage message)
    {
        return InvokeAsync(async () =>
        {
            await LoadDashboardAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        OrderRealtimeClient.OrderUpdated -= HandleOrderUpdatedAsync;
    }

    private sealed record ChartPoint(
        string Label,
        int Value)
    {
        public int HeightPercent { get; init; }
    }

    private sealed record ServiceRank(string Name, int Count, int Percent);

    private sealed record StatusCount(string Name, int Count);
}
