@page "/ui/admin/users"
@attribute [Authorize(Roles = AppConstants.Roles.Admin)]
@inject AdminUsersClient AdminUsersClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Admin", "/ui/admin"), ("Users", null) })" />

<PageHeader Eyebrow="Admin operations"
            Title="User Management"
            Description="Search accounts, manage access, and perform sensitive actions in context.">
    <Actions>
        <MudButton Variant="Variant.Filled"
                   id="create-agent-trigger"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.PersonAdd"
                   OnClick="OpenCreateAgent">
            Create agent
        </MudButton>
    </Actions>
</PageHeader>

<PageSection MaxWidth="wide">
    <DataGridToolbar Title="Users"
                     Description="Search platform users and manage operational account access."
                     Search="@_search"
                     SearchChanged="OnSearchChanged"
                     SearchPlaceholder="Search name or email" />

    @if (!string.IsNullOrWhiteSpace(_actionError) && !_createAgentOpen && !_passwordResetOpen)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
    }

    @if (_loading)
    {
        <LoadingState Text="Loading users" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <ErrorState Title="Unable to load users"
                    Message="@_loadError"
                    OnRetry="@(() => LoadAsync(Math.Max(_users.Page, 1)))" />
    }
    else if (_users.Items.Count == 0)
    {
        <EmptyState Title="No users found"
                    Description="No users match the current search."
                    Icon="@Icons.Material.Outlined.Group" />
    }
    else
    {
        <MudTable Items="@_users.Items" Hover="true" Dense="true" Class="sb-data-table">
            <HeaderContent>
                <MudTh>User</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="User"><strong>@context.FullName</strong><span class="sb-table-subtext">@context.Email</span></MudTd>
                <MudTd DataLabel="Role">@context.Role</MudTd>
                <MudTd DataLabel="Status"><StatusBadge Text="@(context.IsActive ? "Active" : "Inactive")" Tone="@(context.IsActive ? "success" : "neutral")" /></MudTd>
                <MudTd DataLabel="Created">@UserOrderDisplay.FormatDateTime(context.CreatedAt)</MudTd>
                <MudTd DataLabel="Actions">
                    <div class="sb-action-cell">
                        @if (context.Role == AppConstants.Roles.Admin)
                        {
                            <span class="sb-table-subtext">Protected admin account</span>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_actionBusy"
                                       OnClick="@(() => SetStatusAsync(context.UserId, !context.IsActive))">
                                @(context.IsActive ? "Deactivate" : "Activate")
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   id="@($"reset-password-trigger-{context.UserId:N}")"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@_actionBusy"
                                   StartIcon="@Icons.Material.Outlined.Key"
                                   OnClick="@(() => OpenPasswordReset(context))">
                            Reset Password
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_users.TotalPages > 1)
        {
            <div class="sb-pagination">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(_users.Page <= 1 || _loading)"
                           StartIcon="@Icons.Material.Outlined.ChevronLeft"
                           OnClick="PreviousPage">
                    Previous
                </MudButton>
                <span>Page @_users.Page of @_users.TotalPages</span>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(_users.Page >= _users.TotalPages || _loading)"
                           EndIcon="@Icons.Material.Outlined.ChevronRight"
                           OnClick="NextPage">
                    Next
                </MudButton>
            </div>
        }
    }
</PageSection>

@if (_createAgentOpen)
{
    <Drawer Open="true"
            OnCloseRequested="CloseCreateAgent"
            Busy="@_actionBusy"
            ReturnFocusElementId="create-agent-trigger"
            Title="Create agent"
            Eyebrow="User management">
        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
        }
        <EditForm Model="_agentRequest" OnValidSubmit="CreateAgentAsync" class="sb-drawer-form">
            <DataAnnotationsValidator />
            <MudTextField T="string" Label="Full name" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_agentRequest.FullName" />
            <MudTextField T="string" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_agentRequest.Email" />
            <MudTextField T="string" Label="Initial password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_agentRequest.Password" />
            <ValidationSummary />
            <div class="sb-drawer-actions">
                <MudButton Variant="Variant.Text" Disabled="@_actionBusy" OnClick="CloseCreateAgent">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_actionBusy">Create agent</MudButton>
            </div>
        </EditForm>
    </Drawer>
}

@if (_passwordResetOpen && _passwordResetUser is not null)
{
    <Drawer Open="true"
            OnCloseRequested="ClosePasswordReset"
            Busy="@_actionBusy"
            ReturnFocusElementId="@($"reset-password-trigger-{_passwordResetUser.UserId:N}")"
            Title="Reset password"
            Eyebrow="Sensitive action">
        <div class="sb-protected-panel">
            <MudIcon Icon="@Icons.Material.Outlined.Security" />
            <div>
                <strong>@_passwordResetUser.FullName</strong>
                <p class="sb-break-anywhere">@_passwordResetUser.Email</p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_passwordResetError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_passwordResetError</MudAlert>
        }
        <div class="sb-drawer-form">
            <MudTextField T="string"
                          Label="New password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @bind-Value="_newPassword" />
            <p class="sb-field-help">The password is submitted only when you confirm this action and is never shown in the user grid.</p>
            <div class="sb-drawer-actions">
                <MudButton Variant="Variant.Text" Disabled="@_actionBusy" OnClick="ClosePasswordReset">Cancel</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Disabled="@(_actionBusy || string.IsNullOrWhiteSpace(_newPassword))"
                           OnClick="ResetPasswordAsync">
                    Reset password
                </MudButton>
            </div>
        </div>
    </Drawer>
}

@code {
    private const int PageSize = 20;

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    private bool _loading = true;
    private bool _actionBusy;
    private bool _createAgentOpen;
    private bool _passwordResetOpen;
    private string? _loadError;
    private string? _actionError;
    private string? _passwordResetError;
    private string? _search;
    private string? _newPassword;
    private AdminUserListItemDto? _passwordResetUser;
    private PagedResultDto<AdminUserListItemDto> _users = new();
    private CreateAgentRequest _agentRequest = new();

    protected override async Task OnParametersSetAsync()
    {
        _search = Search;
        await LoadAsync(Math.Max(Page ?? 1, 1));
    }

    private async Task OnSearchChanged(string? search)
    {
        _search = search;
        NavigateToPage(1);
        await LoadAsync(1);
    }

    private Task PreviousPage()
    {
        var page = Math.Max(_users.Page - 1, 1);
        NavigateToPage(page);
        return LoadAsync(page);
    }

    private Task NextPage()
    {
        var page = _users.Page + 1;
        NavigateToPage(page);
        return LoadAsync(page);
    }

    private async Task LoadAsync(int page)
    {
        _loading = true;
        _loadError = null;

        var result = await AdminUsersClient.GetUsersAsync(page, PageSize, _search);
        if (RedirectIfAuthRequired(result.RequiresAuthentication))
        {
            return;
        }

        _users = result.Success && result.Data is not null
            ? result.Data
            : new PagedResultDto<AdminUserListItemDto>();
        _loadError = result.ErrorMessage;
        _loading = false;
    }

    private Task CreateAgentAsync()
    {
        if (_actionBusy) return Task.CompletedTask;

        return RunActionAsync(
            () => AdminUsersClient.CreateAgentAsync(_agentRequest),
            () =>
            {
                CloseCreateAgent();
            },
            "Agent account created.");
    }

    private Task SetStatusAsync(Guid userId, bool isActive)
    {
        if (_actionBusy) return Task.CompletedTask;

        return RunActionAsync(
            () => AdminUsersClient.SetUserStatusAsync(userId, isActive),
            () => { },
            isActive ? "User activated." : "User deactivated.");
    }

    private Task ResetPasswordAsync()
    {
        if (_actionBusy) return Task.CompletedTask;

        if (_passwordResetUser is null || string.IsNullOrWhiteSpace(_newPassword))
        {
            _passwordResetError = "Enter a valid new password.";
            return Task.CompletedTask;
        }

        return RunActionAsync(
            () => AdminUsersClient.ResetPasswordAsync(_passwordResetUser.UserId, _newPassword),
            ClosePasswordReset,
            "Password reset completed.",
            message => _passwordResetError = message);
    }

    private async Task RunActionAsync(
        Func<Task<AdminOrdersApiResult<bool>>> action,
        Action onSuccess,
        string successMessage,
        Action<string>? onError = null)
    {
        if (_actionBusy)
        {
            return;
        }

        _actionBusy = true;
        try
        {
            _actionError = null;
            var result = await action();
            if (RedirectIfAuthRequired(result.RequiresAuthentication))
            {
                return;
            }

            if (result.Success)
            {
                onSuccess();
                await LoadAsync(Math.Max(_users.Page, 1));
                Snackbar.Add(successMessage, Severity.Success);
            }
            else
            {
                var message = result.ErrorMessage ?? "Unable to update the user.";
                if (onError is null)
                {
                    _actionError = message;
                }
                else
                {
                    onError(message);
                }
            }
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private void OpenCreateAgent()
    {
        _actionError = null;
        _createAgentOpen = true;
    }

    private void CloseCreateAgent()
    {
        _agentRequest = new CreateAgentRequest();
        _actionError = null;
        _createAgentOpen = false;
    }

    private void OpenPasswordReset(AdminUserListItemDto user)
    {
        _actionError = null;
        _passwordResetError = null;
        _newPassword = null;
        _passwordResetUser = user;
        _passwordResetOpen = true;
    }

    private void ClosePasswordReset()
    {
        _passwordResetOpen = false;
        _passwordResetUser = null;
        _newPassword = null;
        _passwordResetError = null;
    }

    private void NavigateToPage(int page)
    {
        var query = new Dictionary<string, object?>
        {
            ["page"] = page <= 1 ? null : page,
            ["search"] = string.IsNullOrWhiteSpace(_search) ? null : _search
        };

        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters("/ui/admin/users", query),
            replace: true);
    }

    private bool RedirectIfAuthRequired(bool requiresAuthentication)
    {
        if (!requiresAuthentication)
        {
            return false;
        }

        Navigation.NavigateTo("/Account/Login");
        return true;
    }
}
