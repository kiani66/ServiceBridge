@page "/ui/admin/orders/{OrderId:guid}"
@attribute [Authorize(Roles = AppConstants.Roles.Admin)]
@implements IDisposable
@inject AdminOrdersClient AdminOrdersClient
@inject RealtimeClient RealtimeClient
@inject NavigationManager Navigation

@if (_loading)
{
    <PageHeader Eyebrow="Admin management"
                Title="Loading order"
                Description="Fetching the order management view." />
    <PageSection MaxWidth="standard">
        <LoadingState Text="Loading order management" />
    </PageSection>
}
else if (_order is null)
{
    <ErrorState Title="Order unavailable"
                Message="@(_errorMessage ?? "The requested order could not be loaded.")"
                Icon="@Icons.Material.Outlined.SearchOff"
                OnRetry="RequestOrderReloadAsync">
        <Actions>
            <MudButton Href="/ui/admin" Variant="Variant.Outlined" Color="Color.Primary">Back to admin</MudButton>
        </Actions>
    </ErrorState>
}
else
{
    <Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Admin", "/ui/admin"), (_order.OrderNumber, null) })" />

    <PageHeader Eyebrow="Admin order management"
                Title="@_order.OrderNumber"
                Description="@($"{_order.CustomerName} / {_order.ServiceName}")">
        <Actions>
            <StatusBadge Text="@UserOrderDisplay.OrderStatusLabel(_order.Status)"
                         Tone="@UserOrderDisplay.OrderTone(_order.Status)" />
        </Actions>
    </PageHeader>

    <PageSection MaxWidth="wide">
        <div class="sb-order-management-grid">
            <div class="sb-order-stack">
                <OrderSummaryCard Title="Complete order information"
                                  Eyebrow="Admin"
                                  Facts="@SummaryFacts" />

                <CredentialCard Title="Credential information"
                                Eyebrow="Credentials"
                                Description="Values are hidden until an admin explicitly reveals them."
                                RevealValues="@_credentialsRevealed"
                                Items="@DisplayedCredentialItems" />

                <div class="sb-grid-toolbar-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@(_revealBusy || _credentialsRevealed || CredentialItems.Count == 0)"
                               StartIcon="@Icons.Material.Outlined.Visibility"
                               OnClick="RevealCredentialsAsync">
                        Reveal credentials
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(_revealError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                            @_revealError
                        </MudAlert>
                    }
                </div>

                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Assignment</span>
                            <h2>Assignment information</h2>
                        </div>
                    </div>

                    <dl class="sb-fact-list">
                        <div><dt>Current agent</dt><dd>@(_order.AssignedAgentName ?? "-")</dd></div>
                        <div><dt>Assigned at</dt><dd>@FormatNullable(_order.AssignedAt)</dd></div>
                    </dl>

                    @if (_order.Assignments.Count > 0)
                    {
                        <div class="sb-panel-divider">
                            <div class="sb-note-list">
                                @foreach (var assignment in _order.Assignments.OrderByDescending(item => item.AssignedAt))
                                {
                                    <article class="sb-note-item">
                                        <p>@assignment.AgentName</p>
                                        <span>
                                            Assigned by @(assignment.AssignedByAdminName ?? "admin")
                                            / @UserOrderDisplay.FormatDateTime(assignment.AssignedAt)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                        {
                                            <p>@assignment.Notes</p>
                                        }
                                    </article>
                                }
                            </div>
                        </div>
                    }
                </section>

                <NotesPanel Title="Order notes"
                            EmptyText="No notes are attached to this order."
                            Notes="@NoteItems" />
            </div>

            <aside class="sb-order-side-stack">
                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Operations</span>
                            <h2>Admin operations</h2>
                            <p>Open existing operational views for this order.</p>
                        </div>
                    </div>

                    <div class="sb-order-action-stack">
                        <MudButton Href="/ui/admin/orders"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.AssignmentInd">
                            Assignment queue
                        </MudButton>
                        <MudButton Href="/ui/admin/audit"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.ManageHistory">
                            Order events
                        </MudButton>
                        <MudButton Href="/ui/admin/audit-logs"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.FactCheck">
                            Audit logs
                        </MudButton>
                    </div>
                </section>

                @if (_order.ServiceFulfillmentMode == "InventoryCode")
                {
                    <section class="sb-detail-panel sb-order-detail-card">
                        <div class="sb-card-heading">
                            <div>
                                <span class="sb-eyebrow">InventoryCode</span>
                                <h2>Inventory fulfillment</h2>
                            </div>
                            <StatusBadge Text="@InventoryStateLabel(_order.InventoryFulfillmentState)"
                                         Tone="@InventoryStateTone(_order.InventoryFulfillmentState)" />
                        </div>

                        <dl class="sb-fact-list">
                            <div><dt>Service fulfillment mode</dt><dd>@_order.ServiceFulfillmentMode</dd></div>
                            <div><dt>Inventory fulfillment state</dt><dd>@InventoryStateLabel(_order.InventoryFulfillmentState)</dd></div>
                            <div><dt>Allocation status</dt><dd>@(_order.InventoryAllocationStatus ?? "No allocation")</dd></div>
                            <div><dt>Retry eligibility</dt><dd>@(_order.CanRetryInventoryFulfillment ? "Eligible" : "Not eligible")</dd></div>
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(_retryMessage))
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">@_retryMessage</MudAlert>
                        }
                        @if (!string.IsNullOrWhiteSpace(_retryError))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@_retryError</MudAlert>
                        }

                        <div class="sb-grid-toolbar-actions">
                            @if (_order.CanRetryInventoryFulfillment)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@_retryBusy"
                                           StartIcon="@Icons.Material.Outlined.Refresh"
                                           OnClick="OpenRetryDialog">
                                    Retry fulfillment
                                </MudButton>
                            }
                            else
                            {
                                <StatusBadge Text="Retry unavailable" Tone="neutral" />
                            }
                        </div>
                    </section>
                }

                <PaymentCard Title="Payment information"
                             Payments="@_order.Payments" />

                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Refund</span>
                            <h2>Refund status</h2>
                        </div>
                        @if (LatestRefund is not null)
                        {
                            <StatusBadge Text="@UserOrderDisplay.RefundStatusLabel(LatestRefund.Status)"
                                         Tone="@UserOrderDisplay.RefundTone(LatestRefund.Status)" />
                        }
                    </div>

                    @if (_order.RefundRequests.Count == 0)
                    {
                        <p>No refund requests are recorded for this order.</p>
                    }
                    else
                    {
                        <dl class="sb-fact-list">
                            <div><dt>Latest amount</dt><dd>@LatestRefund!.Amount.ToString("N0") IRR</dd></div>
                            <div><dt>Requested</dt><dd>@UserOrderDisplay.FormatDateTime(LatestRefund.CreatedAtUtc)</dd></div>
                            <div><dt>Reviewed</dt><dd>@FormatNullable(LatestRefund.ReviewedAtUtc)</dd></div>
                            <div><dt>Completed</dt><dd>@FormatNullable(LatestRefund.CompletedAtUtc)</dd></div>
                            <div><dt>Reason</dt><dd>@LatestRefund.Reason</dd></div>
                        </dl>
                    }
                </section>

                <PricingSnapshotCard BasePriceUsd="@_order.BasePriceUsdSnapshot"
                                     ExchangeRateIrr="@_order.ExchangeRateSnapshot"
                                     MarginPercent="@_order.MarginSnapshot"
                                     FinalPriceIrr="@_order.FinalPriceIrr" />

                <OrderTimeline CurrentStatus="@_order.Status"
                               Items="@TimelineItems" />
            </aside>
        </div>
    </PageSection>
}

<ConfirmationDialog Open="_retryDialogOpen"
                    OpenChanged="HandleRetryDialogChangedAsync"
                    Title="Retry inventory fulfillment"
                    Description="The system will attempt allocation from available inventory. Inventory codes are never shown or requested here."
                    ConfirmText="@(_retryBusy ? "Retrying..." : "Retry fulfillment")"
                    IsBusy="_retryBusy"
                    OnConfirmed="RetryInventoryFulfillmentAsync" />

@code {
    private readonly RealtimeSubscriptionCollection _realtimeSubscriptions = new();
    private readonly CancellationTokenSource _lifetimeCts = new();
    private RealtimeRefreshCoordinator? _realtimeRefresh;
    private long _loadGeneration;
    private Guid _requestedOrderId;
    private long _revealOperationVersion;
    private long _retryOperationVersion;
    [Parameter] public Guid OrderId { get; set; }

    private bool _disposed;
    private bool _loading = true;
    private bool _revealBusy;
    private bool _retryBusy;
    private bool _retryDialogOpen;
    private bool _credentialsRevealed;
    private string? _errorMessage;
    private string? _revealError;
    private string? _retryError;
    private string? _retryMessage;
    private AdminOrderDetailDto? _order;
    private IReadOnlyList<CredentialDisplayItem> _revealedCredentialItems =
        Array.Empty<CredentialDisplayItem>();

    private IReadOnlyList<OrderFact> SummaryFacts => _order is null
        ? Array.Empty<OrderFact>()
        : new[]
        {
            new OrderFact("Customer", _order.CustomerName),
            new OrderFact("Email", _order.CustomerEmail),
            new OrderFact("Service", _order.ServiceName),
            new OrderFact("Variant", UserOrderDisplay.VariantLabel(_order.PlanName, _order.PlanDurationDays, _order.PlanRegionCode)),
            new OrderFact("Provider", _order.Provider),
            new OrderFact("Fulfillment", _order.FulfillmentMode),
            new OrderFact("Status", UserOrderDisplay.OrderStatusLabel(_order.Status), UserOrderDisplay.OrderTone(_order.Status)),
            new OrderFact("Created", UserOrderDisplay.FormatDateTime(_order.CreatedAt)),
            new OrderFact("Paid", FormatNullable(_order.PaidAt)),
            new OrderFact("Assigned", FormatNullable(_order.AssignedAt)),
            new OrderFact("Completed", FormatNullable(_order.CompletedAt))
        };

    private IReadOnlyList<CredentialDisplayItem> CredentialItems => _order is null
        ? Array.Empty<CredentialDisplayItem>()
        : _order.Credentials
            .OrderBy(field => field.DisplayOrder)
            .Select(field => new CredentialDisplayItem(
                field.FieldLabel,
                field.Value,
                field.IsSensitive,
                field.IsVisibleToCustomerAfterCompletion))
            .ToArray();

    private IReadOnlyList<CredentialDisplayItem> DisplayedCredentialItems =>
        _credentialsRevealed ? _revealedCredentialItems : CredentialItems;

    private IReadOnlyList<NoteDisplayItem> NoteItems => _order is null
        ? Array.Empty<NoteDisplayItem>()
        : _order.Notes
            .OrderByDescending(note => note.CreatedAt)
            .Select(note => new NoteDisplayItem(
                note.Text,
                note.AuthorName,
                UserOrderDisplay.FormatDateTime(note.CreatedAt),
                note.IsVisibleToCustomer ? "Customer visible" : "Internal"))
            .ToArray();

    private IReadOnlyList<TimelineItem> TimelineItems => _order is null
        ? Array.Empty<TimelineItem>()
        : UserOrderDisplay.TimelineItems(_order.StatusHistory);

    private RefundRequestDto? LatestRefund =>
        _order?.RefundRequests
            .OrderByDescending(refund => refund.CreatedAtUtc)
            .ThenByDescending(refund => refund.RefundRequestId)
            .FirstOrDefault();

    protected override void OnInitialized()
    {
        _realtimeRefresh = new RealtimeRefreshCoordinator(RunOrderReloadCoreAsync);
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToOrderUpdates(HandleOrderUpdatedAsync));
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToOrderAssignments(HandleOrderAssignedAsync));
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToCustomerActions(HandleCustomerActionChangedAsync));
    }

    protected override async Task OnParametersSetAsync()
    {
        await RequestOrderReloadAsync();
    }

    private Task RequestOrderReloadAsync()
    {
        return InvokeAsync(RequestOrderReloadOnDispatcherAsync);
    }

    private Task RequestOrderReloadOnDispatcherAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        if (_requestedOrderId != OrderId)
        {
            ResetRevealStateForRouteChange();
        }

        _requestedOrderId = OrderId;
        _loadGeneration++;
        if (!TryApplyRealtimeState(() =>
            {
                _loading = true;
                _errorMessage = null;
                _revealError = null;
                _credentialsRevealed = false;
                _revealedCredentialItems = Array.Empty<CredentialDisplayItem>();
                _order = null;
            }))
        {
            return Task.CompletedTask;
        }

        return _realtimeRefresh?.RunAsync() ?? Task.CompletedTask;
    }

    private Task RunOrderReloadCoreAsync()
    {
        return InvokeAsync(async () =>
        {
            await LoadOrderCoreAsync();
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private async Task LoadOrderCoreAsync()
    {
        var generation = _loadGeneration;
        var orderId = _requestedOrderId;
        try
        {
            var result = await AdminOrdersClient.GetOrderAsync(orderId, _lifetimeCts.Token);
            if (!IsCurrentLoad(generation, orderId))
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                TryApplyCurrentLoad(generation, orderId, () => Navigation.NavigateTo("/Account/Login"));
                return;
            }

            TryApplyCurrentLoad(generation, orderId, () =>
            {
                _order = result.Success ? result.Data : null;
                _errorMessage = result.ErrorMessage;
                _loading = false;
            });
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
    }

    private async Task RevealCredentialsAsync()
    {
        if (_disposed || _revealBusy)
        {
            return;
        }

        var generation = _loadGeneration;
        var orderId = OrderId;
        var operationVersion = ++_revealOperationVersion;
        _revealBusy = true;
        _revealError = null;

        try
        {
            var result = await AdminOrdersClient.RevealCredentialsAsync(
                orderId,
                _lifetimeCts.Token);
            if (!IsCurrentRevealOperation(operationVersion, generation, orderId))
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            if (!result.Success || result.Data is null)
            {
                _revealError = result.ErrorMessage ?? "Unable to reveal credentials.";
                return;
            }

            _revealedCredentialItems = result.Data.Credentials
                .OrderBy(field => field.DisplayOrder)
                .Select(field => new CredentialDisplayItem(
                    field.FieldLabel,
                    field.Value,
                    field.IsSensitive,
                    field.IsVisibleToCustomerAfterCompletion))
                .ToArray();
            _credentialsRevealed = true;
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            if (IsCurrentRevealOperation(operationVersion, orderId))
            {
                _revealBusy = false;
            }
        }
    }

    private void OpenRetryDialog()
    {
        if (_disposed || _retryBusy || _order?.CanRetryInventoryFulfillment != true)
        {
            return;
        }

        _retryError = null;
        _retryMessage = null;
        _retryDialogOpen = true;
    }

    private Task HandleRetryDialogChangedAsync(bool open)
    {
        if (!_retryBusy)
        {
            _retryDialogOpen = open;
        }

        return Task.CompletedTask;
    }

    private async Task RetryInventoryFulfillmentAsync()
    {
        if (_disposed || _retryBusy || _order?.CanRetryInventoryFulfillment != true)
        {
            return;
        }

        var generation = _loadGeneration;
        var orderId = OrderId;
        var operationVersion = ++_retryOperationVersion;
        _retryBusy = true;
        _retryError = null;
        _retryMessage = null;

        try
        {
            var result = await AdminOrdersClient.RetryInventoryCodeFulfillmentAsync(
                orderId,
                _lifetimeCts.Token);
            if (!IsCurrentRetryOperation(operationVersion, generation, orderId))
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            if (result.Success && result.Data is not null)
            {
                _retryMessage = RetryOutcomeMessage(result.Data.Outcome);
            }
            else
            {
                _retryError = result.ErrorMessage ?? "Unable to retry inventory fulfillment.";
            }

            await RequestOrderReloadAsync();
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            if (IsCurrentRetryOperation(operationVersion, orderId))
            {
                _retryBusy = false;
                _retryDialogOpen = false;
            }
        }
    }

    private Task HandleOrderUpdatedAsync(OrderUpdatedRealtimeDto message)
    {
        return RequestRealtimeOrderReloadAsync(message.OrderId);
    }

    private Task HandleOrderAssignedAsync(OrderAssignedRealtimeDto message)
    {
        return RequestRealtimeOrderReloadAsync(message.OrderId);
    }

    private Task HandleCustomerActionChangedAsync(
        CustomerActionChangedRealtimeDto message)
    {
        return RequestRealtimeOrderReloadAsync(message.OrderId);
    }

    private Task RequestRealtimeOrderReloadAsync(Guid messageOrderId)
    {
        return InvokeAsync(() =>
        {
            if (_disposed || messageOrderId != OrderId)
            {
                return Task.CompletedTask;
            }

            return RequestOrderReloadOnDispatcherAsync();
        });
    }

    private bool IsCurrentLoad(long generation, Guid orderId)
    {
        return !_disposed &&
               generation == _loadGeneration &&
               orderId == _requestedOrderId &&
               orderId == OrderId;
    }

    private bool TryApplyCurrentLoad(long generation, Guid orderId, Action apply)
    {
        return IsCurrentLoad(generation, orderId) && TryApplyRealtimeState(apply);
    }

    private bool IsCurrentRevealOperation(long operationVersion, long generation, Guid orderId)
    {
        return IsCurrentRevealOperation(operationVersion, orderId) &&
               IsCurrentLoad(generation, orderId);
    }

    private bool IsCurrentRevealOperation(long operationVersion, Guid orderId)
    {
        return !_disposed &&
               operationVersion == _revealOperationVersion &&
               orderId == OrderId;
    }

    private bool IsCurrentRetryOperation(
        long operationVersion,
        long generation,
        Guid orderId)
    {
        return IsCurrentRetryOperation(operationVersion, orderId) &&
               IsCurrentLoad(generation, orderId);
    }

    private bool IsCurrentRetryOperation(long operationVersion, Guid orderId)
    {
        return !_disposed &&
               operationVersion == _retryOperationVersion &&
               orderId == OrderId;
    }

    private void ResetRevealStateForRouteChange()
    {
        _revealOperationVersion++;
        _retryOperationVersion++;
        _revealBusy = false;
        _revealError = null;
        _credentialsRevealed = false;
        _revealedCredentialItems = Array.Empty<CredentialDisplayItem>();
        _retryBusy = false;
        _retryDialogOpen = false;
        _retryError = null;
        _retryMessage = null;
    }

    private bool TryApplyRealtimeState(Action apply)
    {
        return !_disposed &&
               _realtimeRefresh?.TryApply(apply) == true;
    }

    private static string FormatNullable(DateTime? value)
    {
        return value.HasValue ? UserOrderDisplay.FormatDateTime(value.Value) : "-";
    }

    private static string InventoryStateLabel(AdminInventoryFulfillmentState state)
    {
        return state switch
        {
            AdminInventoryFulfillmentState.AwaitingStock => "Awaiting stock",
            AdminInventoryFulfillmentState.RecoverableAllocation => "Recoverable allocation",
            AdminInventoryFulfillmentState.Inconsistent => "Inconsistent",
            AdminInventoryFulfillmentState.Fulfilled => "Fulfilled",
            _ => "Not applicable"
        };
    }

    private static string InventoryStateTone(AdminInventoryFulfillmentState state)
    {
        return state switch
        {
            AdminInventoryFulfillmentState.AwaitingStock => "warning",
            AdminInventoryFulfillmentState.RecoverableAllocation => "info",
            AdminInventoryFulfillmentState.Inconsistent => "danger",
            AdminInventoryFulfillmentState.Fulfilled => "success",
            _ => "neutral"
        };
    }

    private static string RetryOutcomeMessage(InventoryCodeFulfillmentOutcome outcome)
    {
        return outcome switch
        {
            InventoryCodeFulfillmentOutcome.Fulfilled => "Inventory fulfillment completed.",
            InventoryCodeFulfillmentOutcome.ResumedExistingAllocation => "Existing inventory allocation resumed.",
            InventoryCodeFulfillmentOutcome.AlreadyFulfilled => "This order was already fulfilled.",
            InventoryCodeFulfillmentOutcome.NoInventory => "No inventory is currently available.",
            _ => "Inventory fulfillment was refreshed."
        };
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _revealOperationVersion++;
        _retryOperationVersion++;
        _revealBusy = false;
        _retryBusy = false;
        _retryDialogOpen = false;
        _lifetimeCts.Cancel();
        _realtimeRefresh?.Dispose();
        _realtimeSubscriptions.Dispose();
        _order = null;
        _credentialsRevealed = false;
        _revealedCredentialItems = Array.Empty<CredentialDisplayItem>();
        _lifetimeCts.Dispose();
    }
}
