@page "/ui/admin/orders/{OrderId:guid}"
@attribute [Authorize(Roles = AppConstants.Roles.Admin)]
@implements IDisposable
@inject AdminOrdersClient AdminOrdersClient
@inject RealtimeClient RealtimeClient
@inject NavigationManager Navigation

@if (_loading)
{
    <PageHeader Eyebrow="Admin management"
                Title="Loading order"
                Description="Fetching the order management view." />
    <PageSection MaxWidth="standard">
        <LoadingState Text="Loading order management" />
    </PageSection>
}
else if (_order is null)
{
    <ErrorState Title="Order unavailable"
                Message="@(_errorMessage ?? "The requested order could not be loaded.")"
                Icon="@Icons.Material.Outlined.SearchOff"
                OnRetry="LoadOrderAsync">
        <Actions>
            <MudButton Href="/ui/admin" Variant="Variant.Outlined" Color="Color.Primary">Back to admin</MudButton>
        </Actions>
    </ErrorState>
}
else
{
    <Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Admin", "/ui/admin"), (_order.OrderNumber, null) })" />

    <PageHeader Eyebrow="Admin order management"
                Title="@_order.OrderNumber"
                Description="@($"{_order.CustomerName} / {_order.ServiceName}")">
        <Actions>
            <StatusBadge Text="@UserOrderDisplay.OrderStatusLabel(_order.Status)"
                         Tone="@UserOrderDisplay.OrderTone(_order.Status)" />
        </Actions>
    </PageHeader>

    <PageSection MaxWidth="wide">
        <div class="sb-order-management-grid">
            <div class="sb-order-stack">
                <OrderSummaryCard Title="Complete order information"
                                  Eyebrow="Admin"
                                  Facts="@SummaryFacts" />

                <CredentialCard Title="Credential information"
                                Eyebrow="Credentials"
                                Description="Values are hidden until an admin explicitly reveals them."
                                RevealValues="@_credentialsRevealed"
                                Items="@DisplayedCredentialItems" />

                <div class="sb-grid-toolbar-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@(_revealBusy || _credentialsRevealed || CredentialItems.Count == 0)"
                               StartIcon="@Icons.Material.Outlined.Visibility"
                               OnClick="RevealCredentialsAsync">
                        Reveal credentials
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(_revealError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                            @_revealError
                        </MudAlert>
                    }
                </div>

                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Assignment</span>
                            <h2>Assignment information</h2>
                        </div>
                    </div>

                    <dl class="sb-fact-list">
                        <div><dt>Current agent</dt><dd>@(_order.AssignedAgentName ?? "-")</dd></div>
                        <div><dt>Assigned at</dt><dd>@FormatNullable(_order.AssignedAt)</dd></div>
                    </dl>

                    @if (_order.Assignments.Count > 0)
                    {
                        <div class="sb-panel-divider">
                            <div class="sb-note-list">
                                @foreach (var assignment in _order.Assignments.OrderByDescending(item => item.AssignedAt))
                                {
                                    <article class="sb-note-item">
                                        <p>@assignment.AgentName</p>
                                        <span>
                                            Assigned by @(assignment.AssignedByAdminName ?? "admin")
                                            / @UserOrderDisplay.FormatDateTime(assignment.AssignedAt)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                        {
                                            <p>@assignment.Notes</p>
                                        }
                                    </article>
                                }
                            </div>
                        </div>
                    }
                </section>

                <NotesPanel Title="Order notes"
                            EmptyText="No notes are attached to this order."
                            Notes="@NoteItems" />
            </div>

            <aside class="sb-order-side-stack">
                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Operations</span>
                            <h2>Admin operations</h2>
                            <p>Open existing operational views for this order.</p>
                        </div>
                    </div>

                    <div class="sb-order-action-stack">
                        <MudButton Href="/ui/admin/orders"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.AssignmentInd">
                            Assignment queue
                        </MudButton>
                        <MudButton Href="/ui/admin/audit"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.ManageHistory">
                            Order events
                        </MudButton>
                        <MudButton Href="/ui/admin/audit-logs"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.FactCheck">
                            Audit logs
                        </MudButton>
                    </div>
                </section>

                <PaymentCard Title="Payment information"
                             Payments="@_order.Payments" />

                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Refund</span>
                            <h2>Refund status</h2>
                        </div>
                        @if (LatestRefund is not null)
                        {
                            <StatusBadge Text="@UserOrderDisplay.RefundStatusLabel(LatestRefund.Status)"
                                         Tone="@UserOrderDisplay.RefundTone(LatestRefund.Status)" />
                        }
                    </div>

                    @if (_order.RefundRequests.Count == 0)
                    {
                        <p>No refund requests are recorded for this order.</p>
                    }
                    else
                    {
                        <dl class="sb-fact-list">
                            <div><dt>Latest amount</dt><dd>@LatestRefund!.Amount.ToString("N0") IRR</dd></div>
                            <div><dt>Requested</dt><dd>@UserOrderDisplay.FormatDateTime(LatestRefund.CreatedAtUtc)</dd></div>
                            <div><dt>Reviewed</dt><dd>@FormatNullable(LatestRefund.ReviewedAtUtc)</dd></div>
                            <div><dt>Completed</dt><dd>@FormatNullable(LatestRefund.CompletedAtUtc)</dd></div>
                            <div><dt>Reason</dt><dd>@LatestRefund.Reason</dd></div>
                        </dl>
                    }
                </section>

                <PricingSnapshotCard BasePriceUsd="@_order.BasePriceUsdSnapshot"
                                     ExchangeRateIrr="@_order.ExchangeRateSnapshot"
                                     MarginPercent="@_order.MarginSnapshot"
                                     FinalPriceIrr="@_order.FinalPriceIrr" />

                <OrderTimeline CurrentStatus="@_order.Status"
                               Items="@TimelineItems" />
            </aside>
        </div>
    </PageSection>
}

@code {
    private readonly RealtimeSubscriptionCollection _realtimeSubscriptions = new();
    private RealtimeRefreshCoordinator? _realtimeRefresh;
    [Parameter] public Guid OrderId { get; set; }

    private bool _disposed;
    private bool _loading = true;
    private bool _revealBusy;
    private bool _credentialsRevealed;
    private string? _errorMessage;
    private string? _revealError;
    private AdminOrderDetailDto? _order;
    private IReadOnlyList<CredentialDisplayItem> _revealedCredentialItems =
        Array.Empty<CredentialDisplayItem>();

    private IReadOnlyList<OrderFact> SummaryFacts => _order is null
        ? Array.Empty<OrderFact>()
        : new[]
        {
            new OrderFact("Customer", _order.CustomerName),
            new OrderFact("Email", _order.CustomerEmail),
            new OrderFact("Service", _order.ServiceName),
            new OrderFact("Variant", UserOrderDisplay.VariantLabel(_order.PlanName, _order.PlanDurationDays, _order.PlanRegionCode)),
            new OrderFact("Provider", _order.Provider),
            new OrderFact("Fulfillment", _order.FulfillmentMode),
            new OrderFact("Status", UserOrderDisplay.OrderStatusLabel(_order.Status), UserOrderDisplay.OrderTone(_order.Status)),
            new OrderFact("Created", UserOrderDisplay.FormatDateTime(_order.CreatedAt)),
            new OrderFact("Paid", FormatNullable(_order.PaidAt)),
            new OrderFact("Assigned", FormatNullable(_order.AssignedAt)),
            new OrderFact("Completed", FormatNullable(_order.CompletedAt))
        };

    private IReadOnlyList<CredentialDisplayItem> CredentialItems => _order is null
        ? Array.Empty<CredentialDisplayItem>()
        : _order.Credentials
            .OrderBy(field => field.DisplayOrder)
            .Select(field => new CredentialDisplayItem(
                field.FieldLabel,
                field.Value,
                field.IsSensitive,
                field.IsVisibleToCustomerAfterCompletion))
            .ToArray();

    private IReadOnlyList<CredentialDisplayItem> DisplayedCredentialItems =>
        _credentialsRevealed ? _revealedCredentialItems : CredentialItems;

    private IReadOnlyList<NoteDisplayItem> NoteItems => _order is null
        ? Array.Empty<NoteDisplayItem>()
        : _order.Notes
            .OrderByDescending(note => note.CreatedAt)
            .Select(note => new NoteDisplayItem(
                note.Text,
                note.AuthorName,
                UserOrderDisplay.FormatDateTime(note.CreatedAt),
                note.IsVisibleToCustomer ? "Customer visible" : "Internal"))
            .ToArray();

    private IReadOnlyList<TimelineItem> TimelineItems => _order is null
        ? Array.Empty<TimelineItem>()
        : UserOrderDisplay.TimelineItems(_order.StatusHistory);

    private RefundRequestDto? LatestRefund =>
        _order?.RefundRequests
            .OrderByDescending(refund => refund.CreatedAtUtc)
            .ThenByDescending(refund => refund.RefundRequestId)
            .FirstOrDefault();

    protected override void OnInitialized()
    {
        _realtimeRefresh = new RealtimeRefreshCoordinator(RefreshFromRealtimeCoreAsync);
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToOrderUpdates(HandleOrderUpdatedAsync));
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToOrderAssignments(HandleOrderAssignedAsync));
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToCustomerActions(HandleCustomerActionChangedAsync));
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadOrderAsync();
    }

    private async Task LoadOrderAsync()
    {
        if (!TryApplyRealtimeState(() =>
            {
                _loading = true;
                _errorMessage = null;
                _revealError = null;
                _credentialsRevealed = false;
                _revealedCredentialItems = Array.Empty<CredentialDisplayItem>();
            }))
        {
            return;
        }

        var result = await AdminOrdersClient.GetOrderAsync(OrderId);
        if (result.RequiresAuthentication)
        {
            TryApplyRealtimeState(() => Navigation.NavigateTo("/Account/Login"));
            return;
        }

        TryApplyRealtimeState(() =>
        {
            _order = result.Success ? result.Data : null;
            _errorMessage = result.ErrorMessage;
            _loading = false;
        });
    }

    private async Task RevealCredentialsAsync()
    {
        _revealBusy = true;
        _revealError = null;

        var result = await AdminOrdersClient.RevealCredentialsAsync(OrderId);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!result.Success || result.Data is null)
        {
            _revealError = result.ErrorMessage ?? "Unable to reveal credentials.";
            _revealBusy = false;
            return;
        }

        _revealedCredentialItems = result.Data.Credentials
            .OrderBy(field => field.DisplayOrder)
            .Select(field => new CredentialDisplayItem(
                field.FieldLabel,
                field.Value,
                field.IsSensitive,
                field.IsVisibleToCustomerAfterCompletion))
            .ToArray();
        _credentialsRevealed = true;
        _revealBusy = false;
    }

    private Task HandleOrderUpdatedAsync(OrderUpdatedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return ReloadFromRealtimeAsync();
    }

    private Task HandleOrderAssignedAsync(OrderAssignedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return ReloadFromRealtimeAsync();
    }

    private Task HandleCustomerActionChangedAsync(
        CustomerActionChangedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return ReloadFromRealtimeAsync();
    }

    private Task ReloadFromRealtimeAsync()
    {
        return _realtimeRefresh?.RunAsync() ?? Task.CompletedTask;
    }

    private Task RefreshFromRealtimeCoreAsync()
    {
        Task? refreshTask = null;
        if (!TryApplyRealtimeState(() => refreshTask = InvokeAsync(async () =>
            {
                if (_disposed)
                {
                    return;
                }

                await LoadOrderAsync();
                TryApplyRealtimeState(StateHasChanged);
            })))
        {
            return Task.CompletedTask;
        }

        return refreshTask!;
    }

    private bool TryApplyRealtimeState(Action apply)
    {
        return !_disposed &&
               _realtimeRefresh?.TryApply(apply) == true;
    }

    private static string FormatNullable(DateTime? value)
    {
        return value.HasValue ? UserOrderDisplay.FormatDateTime(value.Value) : "-";
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _realtimeRefresh?.Dispose();
        _realtimeSubscriptions.Dispose();
    }
}
