@page "/ui"
@page "/ui/foundation"

<PageHeader Eyebrow="Blazor foundation"
            Title="ServiceBridge UI system"
            Description="A lightweight Blazor Web App shell for future public catalog, order tracking, agent and admin dashboard screens. Existing Razor Pages remain in place while the UI migrates in small slices.">
    <Actions>
        <MudButton Href="/Services" Variant="Variant.Filled" Color="Color.Primary">
            View Catalog
        </MudButton>
        <MudButton Href="/Admin/Orders" Variant="Variant.Outlined" Color="Color.Primary">
            Admin Orders
        </MudButton>
    </Actions>
</PageHeader>

<div class="sb-foundation-grid">
    <PriceCard Label="Sample variant"
               Amount="$25.00"
               Caption="Snapshot-ready foreign price before IRR conversion."
               Badge="USD" />
    <PriceCard Label="Final amount"
               Amount="4,125,000 IRR"
               Caption="Calculated from exchange-rate and margin snapshots."
               Badge="Ready"
               BadgeTone="success" />
    <PriceCard Label="Operational status"
               Amount="Waiting"
               Caption="Status badges use restrained colors for scanning."
               Badge="Order"
               BadgeTone="warning" />
</div>

<MudPaper Class="sb-card sb-section-card" Elevation="0">
    <FormSection Title="Form foundation"
                 Description="Forms stay left-aligned, compact and predictable for repeated admin and agent work.">
        <div class="sb-form-preview">
            <MudTextField T="string"
                          Label="Customer email"
                          Variant="Variant.Outlined"
                          Placeholder="customer@example.com"
                          FullWidth="true" />
            <MudSelect T="string"
                       Label="Fulfillment mode"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       Value="@_fulfillmentMode">
                <MudSelectItem Value="@("ManualAgent")">Manual agent</MudSelectItem>
                <MudSelectItem Value="@("InventoryCode")">Inventory code</MudSelectItem>
                <MudSelectItem Value="@("ExternalAutomation")">External automation</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary">Save draft</MudButton>
        </div>
    </FormSection>
</MudPaper>

<div class="sb-foundation-grid">
    <MudPaper Class="sb-card" Elevation="0">
        <h2>Dashboard shell</h2>
        <p>Sidebar, top bar and content spacing are ready for future dashboard pages.</p>
        <StatusBadge Text="Foundation" Tone="info" />
    </MudPaper>
    <MudPaper Class="sb-card" Elevation="0">
        <h2>Empty state</h2>
        <EmptyState Title="No records yet"
                    Description="Use focused empty states with one clear next action." />
    </MudPaper>
    <MudPaper Class="sb-card" Elevation="0">
        <h2>Loading state</h2>
        <LoadingState Text="Preparing dashboard data" />
    </MudPaper>
</div>

@code {
    private string _fulfillmentMode = "ManualAgent";
}
