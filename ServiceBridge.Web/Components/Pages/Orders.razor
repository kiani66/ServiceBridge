@page "/ui/orders"
@attribute [Authorize(Roles = AppConstants.Roles.User)]
@implements IDisposable
@inject UserOrdersClient OrdersClient
@inject RealtimeClient RealtimeClient
@inject NavigationManager Navigation

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Orders", null) })" />

<PageHeader Eyebrow="Orders"
            Title="My orders"
            Description="Track payment, fulfillment state, and order history for your service requests.">
    <Actions>
        <MudButton Href="/ui/catalog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">
            New order
        </MudButton>
    </Actions>
</PageHeader>

<PageSection MaxWidth="wide">
    <DataGridToolbar Title="Orders"
                     Description="Newest orders are shown first."
                     ShowSearch="false">
        <Actions>
            <MudSelect T="OrderStatus?"
                       Label="Status"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Value="_status"
                       ValueChanged="OnStatusChanged"
                       Class="sb-search-compact">
                <MudSelectItem T="OrderStatus?" Value="null">All statuses</MudSelectItem>
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <MudSelectItem T="OrderStatus?" Value="@status">
                        @UserOrderDisplay.OrderStatusLabel(status.ToString())
                    </MudSelectItem>
                }
            </MudSelect>
        </Actions>
    </DataGridToolbar>

    @if (_loading)
    {
        <LoadingState Text="Loading orders" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="Unable to load orders"
                    Message="@_errorMessage"
                    OnRetry="@(() => LoadOrdersAsync(Math.Max(_orders.Page, 1)))" />
    }
    else if (_orders.Items.Count == 0)
    {
        <EmptyState Title="No orders found"
                    Description="@EmptyDescription"
                    Icon="@Icons.Material.Outlined.ReceiptLong">
            <Actions>
                <MudButton Href="/ui/catalog" Variant="Variant.Filled" Color="Color.Primary">
                    Browse catalog
                </MudButton>
            </Actions>
        </EmptyState>
    }
    else
    {
        <MudTable Items="@_orders.Items" Hover="true" Dense="true" Class="sb-data-table">
            <HeaderContent>
                <MudTh>Order</MudTh>
                <MudTh>Service</MudTh>
                <MudTh>Variant</MudTh>
                <MudTh>Final IRR price</MudTh>
                <MudTh>Payment</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Paid</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order"><strong>@context.OrderNumber</strong></MudTd>
                <MudTd DataLabel="Service">
                    @context.ServiceName
                    <span class="sb-table-subtext">@context.Provider</span>
                </MudTd>
                <MudTd DataLabel="Variant">@UserOrderDisplay.VariantLabel(context.PlanName, context.PlanDurationDays, context.PlanRegionCode)</MudTd>
                <MudTd DataLabel="Final IRR price">@context.FinalPriceIrr.ToString("N0") IRR</MudTd>
                <MudTd DataLabel="Payment">
                    <StatusBadge Text="@UserOrderDisplay.PaymentStatusLabel(context.PaymentStatus)"
                                 Tone="@UserOrderDisplay.PaymentTone(context.PaymentStatus)" />
                </MudTd>
                <MudTd DataLabel="Status">
                    <StatusBadge Text="@UserOrderDisplay.OrderStatusLabel(context.Status)"
                                 Tone="@UserOrderDisplay.OrderTone(context.Status)" />
                </MudTd>
                <MudTd DataLabel="Created">@UserOrderDisplay.FormatDateTime(context.CreatedAt)</MudTd>
                <MudTd DataLabel="Paid">@FormatNullable(context.PaidAt)</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Href="@($"/ui/orders/{context.OrderId}")"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small">
                        Details
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_orders.TotalPages > 1)
        {
            <div class="sb-pagination">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(_orders.Page <= 1 || _loading)"
                           StartIcon="@Icons.Material.Outlined.ChevronLeft"
                           OnClick="PreviousPage">
                    Previous
                </MudButton>
                <span>Page @_orders.Page of @_orders.TotalPages</span>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(_orders.Page >= _orders.TotalPages || _loading)"
                           EndIcon="@Icons.Material.Outlined.ChevronRight"
                           OnClick="NextPage">
                    Next
                </MudButton>
            </div>
        }
    }
</PageSection>

@code {
    private const int PageSize = 20;

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private bool _loading = true;
    private string? _errorMessage;
    private OrderStatus? _status;
    private PagedResultDto<UserOrderListItemDto> _orders = new();

    private string EmptyDescription => _status.HasValue
        ? "No orders match the selected status."
        : "Your service requests will appear here after checkout.";

    protected override void OnInitialized()
    {
        RealtimeClient.OrderUpdated += HandleOrderUpdatedAsync;
        RealtimeClient.CustomerActionChanged += HandleCustomerActionChangedAsync;
    }

    protected override Task OnParametersSetAsync()
    {
        _status = ParseStatus(StatusQuery);
        return LoadOrdersAsync(1);
    }

    private Task OnStatusChanged(OrderStatus? status)
    {
        var target = status.HasValue
            ? $"/ui/orders?status={Uri.EscapeDataString(status.Value.ToString())}"
            : "/ui/orders";

        Navigation.NavigateTo(target);
        return Task.CompletedTask;
    }

    private Task PreviousPage()
    {
        return LoadOrdersAsync(Math.Max(_orders.Page - 1, 1));
    }

    private Task NextPage()
    {
        return LoadOrdersAsync(_orders.Page + 1);
    }

    private async Task LoadOrdersAsync(int page = 1)
    {
        _loading = true;
        _errorMessage = null;

        var result = await OrdersClient.GetOrdersAsync(page, PageSize, _status);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        _orders = result.Success && result.Data is not null
            ? result.Data
            : new PagedResultDto<UserOrderListItemDto>();
        _errorMessage = result.ErrorMessage;
        _loading = false;
    }

    private Task HandleOrderUpdatedAsync(OrderUpdatedRealtimeDto message)
    {
        return ReloadFromRealtimeAsync();
    }

    private Task HandleCustomerActionChangedAsync(CustomerActionChangedRealtimeDto message)
    {
        return ReloadFromRealtimeAsync();
    }

    private Task ReloadFromRealtimeAsync()
    {
        return InvokeAsync(async () =>
        {
            await LoadOrdersAsync(Math.Max(_orders.Page, 1));
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RealtimeClient.OrderUpdated -= HandleOrderUpdatedAsync;
        RealtimeClient.CustomerActionChanged -= HandleCustomerActionChangedAsync;
    }

    private static OrderStatus? ParseStatus(string? status)
    {
        return Enum.TryParse<OrderStatus>(status, ignoreCase: true, out var parsed)
            ? parsed
            : null;
    }

    private static string FormatNullable(DateTime? value)
    {
        return value.HasValue ? UserOrderDisplay.FormatDateTime(value.Value) : "-";
    }
}
