@page "/ui/profile/password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using ServiceBridge.Application.Validation
@inject UserProfileClient ProfileClient
@inject NavigationManager Navigation

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Profile", "/ui/profile"), ("Password", null) })" />

<PageHeader Eyebrow="Security"
            Title="Change password"
            Description="Update the password used to access your ServiceBridge account.">
    <Actions>
        <MudButton Href="/ui/profile"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.ArrowBack">
            Back
        </MudButton>
    </Actions>
</PageHeader>

<PageSection MaxWidth="form">
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@_successMessage</MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_errorMessage</MudAlert>
    }
    @if (_validationErrors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @foreach (var error in _validationErrors)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    <EditForm Model="_input" OnValidSubmit="ChangePasswordAsync">
        <DataAnnotationsValidator />
        <FormSection Title="Password" Description="Credential fields are handled as sensitive values and are not persisted in the console.">
            <MudTextField T="string"
                          Label="Current password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          For="@(() => _input.CurrentPassword)"
                          @bind-Value="_input.CurrentPassword"
                          Required="true"
                          autocomplete="current-password" />
            <MudTextField T="string"
                          Label="New password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          For="@(() => _input.NewPassword)"
                          @bind-Value="_input.NewPassword"
                          Required="true"
                          autocomplete="new-password" />
            <MudTextField T="string"
                          Label="Confirm new password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          For="@(() => _input.ConfirmNewPassword)"
                          @bind-Value="_input.ConfirmNewPassword"
                          Required="true"
                          autocomplete="new-password" />
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@_saving"
                       StartIcon="@Icons.Material.Outlined.LockReset">
                Change
            </MudButton>
        </FormSection>
    </EditForm>
</PageSection>

@code {
    private readonly PasswordInput _input = new();
    private readonly List<string> _validationErrors = [];
    private bool _saving;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task ChangePasswordAsync()
    {
        _saving = true;
        _errorMessage = null;
        _successMessage = null;
        _validationErrors.Clear();

        var result = await ProfileClient.ChangePasswordAsync(
            _input.CurrentPassword,
            _input.NewPassword,
            _input.ConfirmNewPassword);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage ?? "Failed to change password.";
            foreach (var error in FlattenValidationErrors(result.ValidationErrors))
            {
                _validationErrors.Add(error);
            }

            _saving = false;
            return;
        }

        _input.CurrentPassword = string.Empty;
        _input.NewPassword = string.Empty;
        _input.ConfirmNewPassword = string.Empty;
        _successMessage = "Password changed successfully.";
        _saving = false;
    }

    private static IEnumerable<string> FlattenValidationErrors(Dictionary<string, string[]>? errors)
    {
        return errors?.Values.SelectMany(value => value) ?? [];
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Current password is required.")]
        [DataType(DataType.Password)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required.")]
        [PasswordPolicy]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm new password is required.")]
        [Compare(nameof(NewPassword), ErrorMessage = "New passwords do not match.")]
        [DataType(DataType.Password)]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
