@page "/ui"
@layout PublicOrDashboardLayout
@inject PublicCatalogClient CatalogClient

@if (_loading)
{
    <PageHeader Eyebrow="ServiceBridge"
                Title="Service mediation from request to fulfillment"
                Description="Browse provider-backed digital services, request fulfillment, pay in IRR, and track the order timeline."
                MaxWidth="public" />

    <PageSection MaxWidth="public">
        <LoadingSkeleton Lines="5" Label="Loading public catalog" />
    </PageSection>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <ErrorState Title="Catalog unavailable"
                Message="@_errorMessage"
                Icon="@Icons.Material.Outlined.CloudOff"
                OnRetry="LoadAsync" />
}
else
{
    <PageHeader Eyebrow="ServiceBridge"
                Title="Service mediation from request to fulfillment"
                Description="Browse provider-backed digital services, request fulfillment, pay in IRR, and track the order timeline."
                MaxWidth="public">
        <Actions>
            <MudButton Href="/ui/catalog" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Apps">
                Browse services
            </MudButton>
            <MudButton Href="/Account/Login" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Login">
                Sign in
            </MudButton>
        </Actions>
    </PageHeader>

    <PageSection MaxWidth="public">
        <div class="sb-hero-grid">
            <div class="sb-hero-panel">
                <span class="sb-eyebrow">Featured service</span>
                @if (FeaturedService is null)
                {
                    <h2>No active services yet</h2>
                    <p>The public catalog is ready, but there are no active services to display.</p>
                }
                else
                {
                    <h2>@FeaturedService.Name</h2>
                    <p>@FeaturedService.Description</p>
                    <dl class="sb-fact-list">
                        <div>
                            <dt>Provider</dt>
                            <dd>@FeaturedService.ProviderName</dd>
                        </div>
                        <div>
                            <dt>Live price</dt>
                            <dd>@FeaturedService.PriceLabel</dd>
                        </div>
                    </dl>
                    <div class="sb-hero-actions">
                        <MudButton Href="@FeaturedService.DetailHref" Variant="Variant.Filled" Color="Color.Primary">
                            View details
                        </MudButton>
                        <MudButton Href="/ui/catalog" Variant="Variant.Text" Color="Color.Primary">
                            Compare services
                        </MudButton>
                    </div>
                }
            </div>
            <div class="sb-hero-steps" aria-label="ServiceBridge workflow">
                <div><strong>1</strong><span>Select an active service and variant.</span></div>
                <div><strong>2</strong><span>Review provider, billing period, currency, and live IRR price.</span></div>
                <div><strong>3</strong><span>Submit order fields and credentials only during checkout.</span></div>
                <div><strong>4</strong><span>Track payment and agent fulfillment through completion.</span></div>
            </div>
        </div>
    </PageSection>

    <PageSection Title="Service categories" Description="Focused discovery for active digital-service workflows." MaxWidth="public">
        @if (_categories.Count == 0)
        {
            <EmptyState Title="No active categories"
                        Description="Active categories appear here when they have public services."
                        Icon="@Icons.Material.Outlined.Category" />
        }
        else
        {
            <div class="sb-category-grid">
                @foreach (var category in _categories)
                {
                    <a class="sb-category-card" href="@($"/ui/catalog/{category.Slug}")">
                        <MudIcon Icon="@Icons.Material.Outlined.Category" Size="Size.Large" />
                        <strong>@category.Name</strong>
                        <span>@category.Description</span>
                    </a>
                }
            </div>
        }
    </PageSection>

    <PageSection Id="about" Title="About ServiceBridge" Description="ServiceBridge connects local payment, service information collection, and controlled fulfillment for international digital services." MaxWidth="public">
        <div class="sb-process-grid">
            <div><strong>Service discovery</strong><span>Browse active services and compare provider-backed variants before checkout.</span></div>
            <div><strong>Operational tracking</strong><span>Paid orders move through admin review, agent processing, and timeline updates.</span></div>
            <div><strong>Clear separation</strong><span>Public browsing stays separate from checkout, order creation, and account pages.</span></div>
        </div>
    </PageSection>

    <PageSection Id="faq" Title="FAQ" Description="Common public questions before creating an order." MaxWidth="public">
        <div class="sb-process-grid">
            <div><strong>How is price shown?</strong><span>Public service pages show live IRR quotes from the pricing API.</span></div>
            <div><strong>When do I sign in?</strong><span>Sign in is required only for checkout, orders, payment, and profile pages.</span></div>
            <div><strong>How is fulfillment tracked?</strong><span>Dashboard order details show payment state, notes, and timeline entries.</span></div>
        </div>
    </PageSection>

    <PageSection Id="contact" Title="Contact Us" Description="Use your dashboard order timeline for order-specific support after checkout." MaxWidth="public">
        <div class="sb-process-grid">
            <div><strong>Public questions</strong><span>Use the public catalog to review service details before signing in.</span></div>
            <div><strong>Order support</strong><span>After checkout, use the authenticated dashboard for order-specific communication.</span></div>
            <div><strong>Account access</strong><span>Login and registration are available from the public navigation when needed.</span></div>
        </div>
    </PageSection>
}

@code {
    private bool _loading = true;
    private string? _errorMessage;
    private IReadOnlyList<PublicCatalogCategory> _categories = [];
    private IReadOnlyList<PublicCatalogService> _services = [];

    private PublicCatalogService? FeaturedService => _services.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;

        var result = await CatalogClient.GetCatalogAsync();
        if (result.Success)
        {
            _categories = result.Categories;
            _services = result.Services;
        }
        else
        {
            _categories = [];
            _services = [];
            _errorMessage = result.ErrorMessage ?? "Unable to load the public catalog.";
        }

        _loading = false;
    }
}
