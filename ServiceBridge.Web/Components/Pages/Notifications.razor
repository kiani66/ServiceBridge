@page "/ui/notifications"
@attribute [Authorize]
@inject NotificationsClient NotificationsClient
@inject NavigationManager Navigation
@inject RealtimeClient RealtimeClient
@implements IDisposable

<PageHeader Eyebrow="Notifications"
            Title="In-app notifications"
            Description="Order, payment, assignment, and fulfillment updates for your account.">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   OnClick="ReloadAsync">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.DoneAll"
                   Disabled="@(_unreadCount == 0)"
                   OnClick="MarkAllAsReadAsync">
            Mark all read
        </MudButton>
    </Actions>
</PageHeader>

<PageSection Title="Notification center"
             Description="Unread items appear first."
             MaxWidth="wide">
    <div class="sb-grid-toolbar">
        <div>
            <h2>Inbox</h2>
            <p>@_unreadCount unread of @_notifications.TotalCount total notifications.</p>
        </div>
        <div class="sb-grid-toolbar-actions">
            <MudSwitch T="bool"
                       Value="@_unreadOnly"
                       ValueChanged="OnUnreadOnlyChanged"
                       Color="Color.Primary"
                       Label="Unread only" />
        </div>
    </div>

    @if (_loading)
    {
        <LoadingState Message="Loading notifications..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="Notifications unavailable"
                    Message="@_errorMessage"
                    Icon="@Icons.Material.Outlined.NotificationsOff"
                    OnRetry="ReloadAsync" />
    }
    else if (_notifications.Items.Count == 0)
    {
        <EmptyState Title="No notifications"
                    Description="New order and fulfillment updates will appear here."
                    Icon="@Icons.Material.Outlined.NotificationsNone" />
    }
    else
    {
        <MudTable Items="@_notifications.Items" Hover="true" Dense="true" Class="sb-data-table">
            <HeaderContent>
                <MudTh>Status</MudTh>
                <MudTh>Notification</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Status">
                    <StatusBadge Text="@(context.IsRead ? "Read" : "Unread")"
                                 Tone="@(context.IsRead ? "neutral" : "info")" />
                </MudTd>
                <MudTd DataLabel="Notification">
                    <strong>@context.Title</strong>
                    <span class="sb-table-subtext">@context.Body</span>
                </MudTd>
                <MudTd DataLabel="Created">@FormatDateTime(context.CreatedAtUtc)</MudTd>
                <MudTd DataLabel="Action">
                    <NotificationListActions Notification="@context"
                                             Busy="@_busyNotifications.Contains(context.Id)"
                                             OnOpen="OpenRelatedAsync"
                                             OnMarkAsRead="MarkAsReadAsync" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="sb-pagination">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Disabled="@(_notifications.Page <= 1)"
                       OnClick="PreviousPageAsync">
                Previous
            </MudButton>
            <span>Page @_notifications.Page of @_notifications.TotalPages</span>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Disabled="@(_notifications.Page >= _notifications.TotalPages)"
                       OnClick="NextPageAsync">
                Next
            </MudButton>
        </div>
    }
</PageSection>

@code {
    private readonly RealtimeSubscriptionCollection _realtimeSubscriptions = new();
    private readonly HashSet<Guid> _busyNotifications = new();
    private readonly CancellationTokenSource _lifetimeCts = new();
    private const int PageSize = 20;

    private CoalescingAsyncAction? _refreshAction;
    private bool _disposed;
    private bool _loading = true;
    private bool _markAllBusy;
    private bool _unreadOnly;
    private int _unreadCount;
    private int _requestedPage = 1;
    private bool _requestedUnreadOnly;
    private long _mutationVersion;
    private long _requestVersion;
    private string? _errorMessage;
    private PagedResultDto<NotificationDto> _notifications = new()
    {
        Page = 1,
        PageSize = PageSize
    };

    protected override async Task OnInitializedAsync()
    {
        _refreshAction = new CoalescingAsyncAction(LoadCoreAsync);
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToNotifications(HandleNotificationReceivedAsync));
        await RequestLoadAsync(1);
    }

    private Task RequestLoadAsync(int page)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _requestedPage = Math.Max(page, 1);
        _requestedUnreadOnly = _unreadOnly;
        _requestVersion++;
        return _refreshAction?.RequestAsync() ?? Task.CompletedTask;
    }

    private async Task LoadCoreAsync()
    {
        var page = _requestedPage;
        var unreadOnly = _requestedUnreadOnly;
        var requestVersion = _requestVersion;
        var mutationVersion = _mutationVersion;
        _loading = true;
        _errorMessage = null;

        NotificationsApiResult<PagedResultDto<NotificationDto>> notificationsResult;
        NotificationsApiResult<UnreadNotificationCountDto> countResult;
        try
        {
            notificationsResult = await NotificationsClient.GetNotificationsAsync(
                page,
                PageSize,
                unreadOnly,
                _lifetimeCts.Token);
            countResult = await NotificationsClient.GetUnreadCountAsync(_lifetimeCts.Token);
        }
        catch (OperationCanceledException) when (_disposed)
        {
            return;
        }

        if (_disposed)
        {
            return;
        }

        if (notificationsResult.RequiresAuthentication ||
            countResult.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (requestVersion != _requestVersion ||
            mutationVersion != _mutationVersion)
        {
            _ = _refreshAction?.RequestAsync();
            return;
        }

        if (!notificationsResult.Success)
        {
            _errorMessage = notificationsResult.ErrorMessage;
        }
        else
        {
            _notifications = notificationsResult.Data ?? new PagedResultDto<NotificationDto>();
        }

        if (!countResult.Success)
        {
            _errorMessage ??= countResult.ErrorMessage;
        }
        else
        {
            _unreadCount = countResult.Data?.Count ?? 0;
        }

        _loading = false;
    }

    private Task ReloadAsync()
    {
        return RequestLoadAsync(_notifications.Page <= 0 ? 1 : _notifications.Page);
    }

    private async Task OnUnreadOnlyChanged(bool value)
    {
        _unreadOnly = value;
        await RequestLoadAsync(1);
    }

    private async Task MarkAsReadAsync(NotificationDto notification)
    {
        if (_disposed || !_busyNotifications.Add(notification.Id))
        {
            return;
        }

        try
        {
            var result = await NotificationsClient.MarkAsReadAsync(
                notification.Id,
                _lifetimeCts.Token);
            if (_disposed)
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            if (result.Success)
            {
                ApplyReadMutation(notification.Id);
            }

            QueueAuthoritativeRefresh();
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            if (!_disposed)
            {
                _busyNotifications.Remove(notification.Id);
            }
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        if (_disposed || _markAllBusy)
        {
            return;
        }

        _markAllBusy = true;
        try
        {
            var result = await NotificationsClient.MarkAllAsReadAsync(_lifetimeCts.Token);
            if (_disposed)
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            if (result.Success)
            {
                ApplyMarkAllMutation();
            }

            QueueAuthoritativeRefresh(page: 1);
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            if (!_disposed)
            {
                _markAllBusy = false;
            }
        }
    }

    private Task PreviousPageAsync()
    {
        return RequestLoadAsync(Math.Max(_notifications.Page - 1, 1));
    }

    private Task NextPageAsync()
    {
        return RequestLoadAsync(_notifications.Page + 1);
    }

    private async Task OpenRelatedAsync(NotificationDto notification)
    {
        if (_disposed || !_busyNotifications.Add(notification.Id))
        {
            return;
        }

        try
        {
            var wasUnread = !notification.IsRead;
            var preparation = await NotificationNavigation.PrepareOpenAsync(
                notification,
                () => Task.CompletedTask,
                id => NotificationsClient.MarkAsReadAsync(id, _lifetimeCts.Token),
                () => !_disposed);
            if (_disposed)
            {
                return;
            }

            if (wasUnread && preparation.MarkedAsRead)
            {
                ApplyReadMutation(notification.Id);
            }

            if (wasUnread)
            {
                QueueAuthoritativeRefresh();
            }

            if (preparation.Route is not null)
            {
                Navigation.NavigateTo(preparation.Route);
            }
        }
        finally
        {
            if (!_disposed)
            {
                _busyNotifications.Remove(notification.Id);
            }
        }
    }

    private static string FormatDateTime(DateTime value)
    {
        return value.ToString("yyyy-MM-dd HH:mm") + " UTC";
    }

    private Task HandleNotificationReceivedAsync(RealtimeEventDto notification)
    {
        return InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            if (notification.UnreadCount.HasValue)
            {
                _mutationVersion++;
                _unreadCount = Math.Max(0, notification.UnreadCount.Value);
            }

            await RequestLoadAsync(_unreadOnly ? 1 : Math.Max(_notifications.Page, 1));
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void ApplyReadMutation(Guid notificationId)
    {
        var current = _notifications.Items.FirstOrDefault(item => item.Id == notificationId);
        if (current is null || current.IsRead)
        {
            return;
        }

        _mutationVersion++;
        current.IsRead = true;
        _unreadCount = Math.Max(0, _unreadCount - 1);
        if (_unreadOnly)
        {
            _notifications.Items = _notifications.Items
                .Where(item => item.Id != notificationId)
                .ToArray();
            _notifications.TotalCount = Math.Max(0, _notifications.TotalCount - 1);
        }
    }

    private void ApplyMarkAllMutation()
    {
        _mutationVersion++;
        foreach (var notification in _notifications.Items)
        {
            notification.IsRead = true;
        }

        _unreadCount = 0;
        if (_unreadOnly)
        {
            _notifications.Items = Array.Empty<NotificationDto>();
            _notifications.TotalCount = 0;
        }
    }

    private void QueueAuthoritativeRefresh(int? page = null)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RequestLoadAsync(page ?? Math.Max(_notifications.Page, 1));
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetimeCts.Cancel();
        _refreshAction?.Dispose();
        _realtimeSubscriptions.Dispose();
        _lifetimeCts.Dispose();
    }
}
