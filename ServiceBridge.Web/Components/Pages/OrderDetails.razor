@page "/ui/orders/{OrderId:guid}"
@attribute [Authorize(Roles = AppConstants.Roles.User)]
@implements IDisposable
@inject UserOrdersClient OrdersClient
@inject RefundsClient RefundsClient
@inject PaymentClient PaymentClient
@inject RealtimeClient RealtimeClient
@inject NavigationManager Navigation

@if (_loading)
{
    <PageHeader Eyebrow="Order details"
                Title="Loading order"
                Description="Fetching the latest order state." />
    <PageSection MaxWidth="standard">
        <LoadingState Text="Loading order" />
    </PageSection>
}
else if (_order is null)
{
    <ErrorState Title="Order unavailable"
                Message="@(_errorMessage ?? "The requested order could not be loaded.")"
                Icon="@Icons.Material.Outlined.SearchOff"
                OnRetry="LoadOrderAsync">
        <Actions>
            <MudButton Href="/ui/orders" Variant="Variant.Outlined" Color="Color.Primary">Back to orders</MudButton>
        </Actions>
    </ErrorState>
}
else
{
    <Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Orders", "/ui/orders"), (_order.OrderNumber, null) })" />

    <PageHeader Eyebrow="Order details"
                Title="@_order.OrderNumber"
                Description="@($"{_order.ServiceName} via {_order.Provider}")">
        <Actions>
            @if (_order.Status == nameof(OrderStatus.WaitingForPayment))
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_paymentBusy"
                           StartIcon="@Icons.Material.Outlined.Payment"
                           OnClick="InitiatePaymentAsync">
                    Pay
                </MudButton>
            }
            @if (_order.CanCancel)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Disabled="@_cancelBusy"
                           StartIcon="@Icons.Material.Outlined.Cancel"
                           OnClick="@(() => _cancelDialogOpen = true)">
                    Cancel
                </MudButton>
            }
            <MudButton Href="@SupportHref"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.SupportAgent">
                Open support ticket
            </MudButton>
        </Actions>
    </PageHeader>

    <PageSection MaxWidth="wide">
        <div class="sb-order-management-grid">
            <div class="sb-order-stack">
                @if (!string.IsNullOrWhiteSpace(_paymentError))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_paymentError</MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(_cancelError))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_cancelError</MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(_cancelMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@_cancelMessage</MudAlert>
                }

                <OrderSummaryCard Title="Order information"
                                  Eyebrow="Customer order"
                                  Facts="@SummaryFacts" />

                @if (PendingCustomerAction is not null)
                {
                    <section class="sb-detail-panel sb-order-detail-card">
                        <div class="sb-card-heading">
                            <div>
                                <span class="sb-eyebrow">Action required</span>
                                <h2>Additional information required</h2>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_customerActionMessage))
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@_customerActionMessage</MudAlert>
                        }
                        @if (!string.IsNullOrWhiteSpace(_customerActionError))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_customerActionError</MudAlert>
                        }
                        <p>@PendingCustomerAction.RequestText</p>
                        @if (!_showCustomerActionForm)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_customerActionBusy"
                                       StartIcon="@Icons.Material.Outlined.EditNote"
                                       OnClick="@(() => _showCustomerActionForm = true)">
                                Provide Information
                            </MudButton>
                        }
                        else
                        {
                            <div class="sb-order-form">
                                <MudTextField T="string"
                                              Label="Response message"
                                              Variant="Variant.Outlined"
                                              Lines="4"
                                              Required="true"
                                              MaxLength="2000"
                                              Value="@_customerActionResponse"
                                              ValueChanged="@((string? value) => _customerActionResponse = value ?? string.Empty)" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@_customerActionBusy"
                                           StartIcon="@Icons.Material.Outlined.Send"
                                           OnClick="SubmitCustomerActionResponseAsync">
                                    Submit
                                </MudButton>
                            </div>
                        }
                    </section>
                }

                @if (ResolvedCustomerActions.Count > 0)
                {
                    <section class="sb-detail-panel sb-order-detail-card">
                        <div class="sb-card-heading">
                            <div>
                                <span class="sb-eyebrow">Information requests</span>
                                <h2>Submitted responses</h2>
                            </div>
                        </div>
                        <div class="sb-note-list">
                            @foreach (var action in ResolvedCustomerActions)
                            {
                                <article class="sb-note-item">
                                    <strong>Request message</strong>
                                    <p>@action.RequestText</p>
                                    <strong>Your response</strong>
                                    <p>@action.CustomerResponse</p>
                                    <span>@FormatNullable(action.RespondedAt)</span>
                                </article>
                            }
                        </div>
                    </section>
                }

                <CredentialCard Title="Credential summary"
                                Eyebrow="Fulfillment"
                                Description="Sensitive values stay hidden in the customer console."
                                Items="@CredentialItems" />

                <NotesPanel Title="Agent notes"
                            Description="Customer-visible fulfillment notes."
                            EmptyText="Agent notes will appear here when there is an update for you."
                            Notes="@NoteItems" />
            </div>

            <aside class="sb-order-side-stack">
                <PaymentCard Payments="@_order.Payments" />

                <PricingSnapshotCard BasePriceUsd="@_order.BasePriceUsdSnapshot"
                                     ExchangeRateIrr="@_order.ExchangeRateSnapshot"
                                     MarginPercent="@_order.MarginSnapshot"
                                     FinalPriceIrr="@_order.FinalPriceIrr" />

                <OrderTimeline CurrentStatus="@_order.Status"
                               Items="@TimelineItems" />
            </aside>
        </div>
    </PageSection>

    <PageSection Title="Refund requests" Description="Controlled refund review for eligible paid orders." MaxWidth="wide">
        <div class="sb-detail-grid">
            <div class="sb-detail-panel">
                <h2>Refund action</h2>
                @if (!string.IsNullOrWhiteSpace(_refundMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@_refundMessage</MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(_refundError))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_refundError</MudAlert>
                }
                @if (CanRequestRefund)
                {
                    <div class="sb-order-form">
                        <MudTextField T="string"
                                      Label="Refund reason"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      MaxLength="1000"
                                      Value="_refundReason"
                                      ValueChanged="@((string? value) => _refundReason = value)" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@_refundBusy"
                                   StartIcon="@Icons.Material.Outlined.AssignmentReturn"
                                   OnClick="RequestRefundAsync">
                            Request refund
                        </MudButton>
                    </div>
                }
                else
                {
                    <p>This order is not currently eligible for a new refund request.</p>
                }
            </div>

            <div class="sb-detail-panel">
                <h2>Refund status</h2>
                @if (_refundsLoading)
                {
                    <LoadingState Text="Loading refunds" />
                }
                else if (_refunds.Count == 0)
                {
                    <p>No refund requests have been submitted for this order.</p>
                }
                else
                {
                    <dl class="sb-fact-list">
                        @foreach (var refund in _refunds.OrderByDescending(x => x.CreatedAtUtc))
                        {
                            <div>
                                <dt>@UserOrderDisplay.FormatDateTime(refund.CreatedAtUtc)</dt>
                                <dd>
                                    <StatusBadge Text="@UserOrderDisplay.RefundStatusLabel(refund.Status)"
                                                 Tone="@UserOrderDisplay.RefundTone(refund.Status)" />
                                    @refund.Amount.ToString("N0") IRR / @refund.Reason
                                </dd>
                            </div>
                        }
                    </dl>
                }
            </div>
        </div>
    </PageSection>

    <ConfirmationDialog Open="_cancelDialogOpen"
                        OpenChanged="@((bool open) => _cancelDialogOpen = open)"
                        Title="Cancel order"
                        Description="Cancel this order and stop any pending fulfillment work."
                        ConfirmText="Cancel order"
                        Color="Color.Error"
                        OnConfirmed="CancelOrderAsync" />
}

@code {
    private readonly RealtimeSubscriptionCollection _realtimeSubscriptions = new();
    [Parameter] public Guid OrderId { get; set; }

    private bool _loading = true;
    private bool _refundBusy;
    private bool _refundsLoading;
    private bool _customerActionBusy;
    private bool _showCustomerActionForm;
    private bool _paymentBusy;
    private bool _cancelBusy;
    private bool _cancelDialogOpen;
    private string? _errorMessage;
    private string? _refundError;
    private string? _refundMessage;
    private string? _refundReason;
    private string? _customerActionError;
    private string? _customerActionMessage;
    private string? _paymentError;
    private string? _cancelError;
    private string? _cancelMessage;
    private string _customerActionResponse = string.Empty;
    private UserOrderDetailDto? _order;
    private IReadOnlyCollection<RefundRequestDto> _refunds = Array.Empty<RefundRequestDto>();

    private string SupportHref => _order is null
        ? "/ui/tickets/new"
        : $"/ui/tickets/new?orderId={_order.OrderId}";

    private IReadOnlyList<OrderFact> SummaryFacts => _order is null
        ? Array.Empty<OrderFact>()
        : new[]
        {
            new OrderFact("Service", _order.ServiceName),
            new OrderFact("Variant", UserOrderDisplay.VariantLabel(_order.PlanName, _order.PlanDurationDays, _order.PlanRegionCode)),
            new OrderFact("Provider", _order.Provider),
            new OrderFact("Fulfillment", _order.FulfillmentMode),
            new OrderFact("Order status", UserOrderDisplay.OrderStatusLabel(_order.Status), UserOrderDisplay.OrderTone(_order.Status)),
            new OrderFact("Created", UserOrderDisplay.FormatDateTime(_order.CreatedAt)),
            new OrderFact("Paid", FormatNullable(_order.PaidAt)),
            new OrderFact("Assigned", FormatNullable(_order.AssignedAt)),
            new OrderFact("Completed", FormatNullable(_order.CompletedAt))
        };

    private IReadOnlyList<CredentialDisplayItem> CredentialItems => _order is null
        ? Array.Empty<CredentialDisplayItem>()
        : _order.Fields
            .Concat(_order.DeliveryFields)
            .OrderBy(field => field.DisplayOrder)
            .Select(field => new CredentialDisplayItem(
                field.FieldLabel,
                field.Value,
                field.IsSensitive))
            .ToArray();

    private IReadOnlyList<NoteDisplayItem> NoteItems => _order is null
        ? Array.Empty<NoteDisplayItem>()
        : _order.Notes
            .OrderByDescending(note => note.CreatedAt)
            .Select(note => new NoteDisplayItem(
                note.Text,
                note.AuthorName,
                UserOrderDisplay.FormatDateTime(note.CreatedAt),
                "Customer visible"))
            .ToArray();

    private IReadOnlyList<TimelineItem> TimelineItems =>
        _order is null
            ? Array.Empty<TimelineItem>()
            : UserOrderDisplay.TimelineItems(_order.StatusHistory);

    private bool CanRequestRefund =>
        _order is not null &&
        UserOrderDisplay.CanRequestRefund(_order.Status) &&
        _order.Payments.Any(x => x.Status == nameof(PaymentStatus.Completed)) &&
        !_refunds.Any(x => x.Status is nameof(RefundStatus.Requested) or nameof(RefundStatus.Approved));

    private CustomerActionRequestDto? PendingCustomerAction => _order?.CustomerActions
        .OrderByDescending(action => action.RequestedAt)
        .FirstOrDefault(action => !action.IsResolved);

    private IReadOnlyList<CustomerActionRequestDto> ResolvedCustomerActions => _order is null
        ? Array.Empty<CustomerActionRequestDto>()
        : _order.CustomerActions
            .Where(action => action.IsResolved)
            .OrderByDescending(action => action.RespondedAt ?? action.RequestedAt)
            .ToArray();

    protected override void OnInitialized()
    {
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToOrderUpdates(HandleOrderUpdatedAsync));
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToCustomerActions(HandleCustomerActionChangedAsync));
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadOrderAsync();
    }

    private async Task LoadOrderAsync()
    {
        _loading = true;
        _errorMessage = null;

        var result = await OrdersClient.GetOrderAsync(OrderId);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        _order = result.Success ? result.Data : null;
        _errorMessage = result.ErrorMessage;
        if (PendingCustomerAction is null)
        {
            _showCustomerActionForm = false;
            _customerActionResponse = string.Empty;
        }

        await LoadRefundsAsync();
        _loading = false;
    }

    private async Task LoadRefundsAsync()
    {
        if (_order is null)
        {
            _refunds = Array.Empty<RefundRequestDto>();
            return;
        }

        _refundsLoading = true;
        var result = await RefundsClient.GetOrderRefundsAsync(_order.OrderId);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        _refunds = result.Success && result.Data is not null
            ? result.Data.Items
            : Array.Empty<RefundRequestDto>();
        _refundsLoading = false;
    }

    private async Task RequestRefundAsync()
    {
        _refundError = null;
        _refundMessage = null;

        if (string.IsNullOrWhiteSpace(_refundReason))
        {
            _refundError = "Enter a refund reason before submitting.";
            return;
        }

        _refundBusy = true;
        var result = await RefundsClient.CreateAsync(OrderId, _refundReason);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!result.Success)
        {
            _refundError = result.ErrorMessage ?? "Unable to submit this refund request.";
            _refundBusy = false;
            return;
        }

        _refundReason = null;
        _refundMessage = "Refund request submitted.";
        await LoadRefundsAsync();
        _refundBusy = false;
    }

    private async Task InitiatePaymentAsync()
    {
        _paymentError = null;
        _paymentBusy = true;

        var initiateResult = await PaymentClient.InitiatePaymentAsync(OrderId, Guid.NewGuid());
        if (initiateResult.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!initiateResult.Success || initiateResult.Data is null)
        {
            _paymentError = initiateResult.ErrorMessage ?? "Unable to start payment for this order.";
            _paymentBusy = false;
            return;
        }

        var mockResult = await PaymentClient.ProcessMockPaymentAsync(
            initiateResult.Data.PaymentId,
            succeed: true);
        if (mockResult.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!mockResult.Success || mockResult.Data is null)
        {
            _paymentError = mockResult.ErrorMessage ?? "Unable to process the mock payment.";
            _paymentBusy = false;
            return;
        }

        var route = mockResult.Data.Status == PaymentStatus.Completed
            ? "success"
            : "failure";

        Navigation.NavigateTo(
            $"/ui/payments/{route}/{mockResult.Data.OrderId}?paymentId={mockResult.Data.PaymentId}");
    }

    private async Task CancelOrderAsync()
    {
        _cancelError = null;
        _cancelMessage = null;
        _cancelBusy = true;

        var result = await OrdersClient.CancelOrderAsync(OrderId);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!result.Success)
        {
            _cancelError = result.ErrorMessage ?? "Unable to cancel this order.";
            _cancelBusy = false;
            return;
        }

        _cancelMessage = "Order cancelled successfully.";
        await LoadOrderAsync();
        _cancelBusy = false;
    }

    private async Task SubmitCustomerActionResponseAsync()
    {
        _customerActionError = null;
        _customerActionMessage = null;
        var pendingRequest = PendingCustomerAction;
        if (pendingRequest is null)
        {
            _customerActionError = "This information request is no longer pending.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_customerActionResponse))
        {
            _customerActionError = "Enter a response before submitting.";
            return;
        }

        _customerActionBusy = true;
        var result = await OrdersClient.RespondToCustomerActionAsync(
            OrderId,
            pendingRequest.Id,
            _customerActionResponse);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!result.Success)
        {
            _customerActionError = result.ErrorMessage ?? "Unable to submit your response.";
            _customerActionBusy = false;
            return;
        }

        _customerActionResponse = string.Empty;
        _showCustomerActionForm = false;
        _customerActionMessage = "Information submitted.";
        await LoadOrderAsync();
        _customerActionBusy = false;
    }

    private Task HandleOrderUpdatedAsync(OrderUpdatedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return ReloadFromRealtimeAsync();
    }

    private Task HandleCustomerActionChangedAsync(
        CustomerActionChangedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return ReloadFromRealtimeAsync();
    }

    private Task ReloadFromRealtimeAsync()
    {
        return InvokeAsync(async () =>
        {
            await LoadOrderAsync();
            StateHasChanged();
        });
    }

    private static string FormatNullable(DateTime? value)
    {
        return value.HasValue ? UserOrderDisplay.FormatDateTime(value.Value) : "-";
    }

    public void Dispose()
    {
        _realtimeSubscriptions.Dispose();
    }
}
