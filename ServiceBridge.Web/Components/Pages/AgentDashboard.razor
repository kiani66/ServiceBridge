@page "/ui/agent"
@attribute [Authorize(Roles = AppConstants.Roles.Agent)]
@implements IDisposable
@inject AgentOrdersClient AgentOrdersClient
@inject OrderRealtimeClient OrderRealtimeClient
@inject NavigationManager Navigation

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Agent", null) })" />

<PageHeader Eyebrow="Agent workspace"
            Title="Agent Dashboard"
            Description="Process assigned service requests, respond to customer needs, and complete fulfillment work quickly." />

<PageSection MaxWidth="wide">
    @if (_summaryLoading)
    {
        <LoadingState Text="Loading agent dashboard" />
    }
    else if (!string.IsNullOrWhiteSpace(_summaryError))
    {
        <ErrorState Title="Unable to load agent dashboard"
                    Message="@_summaryError"
                    OnRetry="LoadSummaryAsync" />
    }
    else if (_summary is not null)
    {
        <div class="sb-stat-grid">
            <StatCard Label="Assigned Orders"
                      Value="@_summary.AssignedOrders.ToString("N0")"
                      Description="Ready to start"
                      Tone="info"
                      Icon="@Icons.Material.Outlined.AssignmentInd" />
            <StatCard Label="Processing"
                      Value="@_summary.ProcessingOrders.ToString("N0")"
                      Description="Currently being fulfilled"
                      Tone="warning"
                      Icon="@Icons.Material.Outlined.ManageHistory" />
            <StatCard Label="Waiting Customer"
                      Value="@WaitingCustomerCount.ToString("N0")"
                      Description="Loaded orders with pending customer action"
                      Tone="warning"
                      Icon="@Icons.Material.Outlined.MarkEmailUnread" />
            <StatCard Label="Completed Today"
                      Value="@_summary.CompletedToday.ToString("N0")"
                      Description="Finished since UTC day start"
                      Tone="success"
                      Icon="@Icons.Material.Outlined.CheckCircle" />
        </div>
    }
</PageSection>

<PageSection MaxWidth="wide">
    <div class="sb-dashboard-grid sb-dashboard-grid-two">
        <section class="sb-dashboard-panel">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Main Work Queue</h2>
                    <p>Newest assigned and processing orders are shown first.</p>
                </div>
            </div>

            <DataGridToolbar Title="Orders assigned to me"
                             Description="Filter the queue without leaving the workspace."
                             Search="@_search"
                             SearchChanged="OnSearchChanged"
                             SearchPlaceholder="Search order, customer, service">
                <Actions>
                    <MudSelect T="OrderStatus?"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Value="_status"
                               ValueChanged="OnStatusChanged"
                               Class="sb-search-compact">
                        <MudSelectItem T="OrderStatus?" Value="null">All statuses</MudSelectItem>
                        <MudSelectItem T="OrderStatus?" Value="@OrderStatus.Assigned">Assigned</MudSelectItem>
                        <MudSelectItem T="OrderStatus?" Value="@OrderStatus.Processing">Processing</MudSelectItem>
                        <MudSelectItem T="OrderStatus?" Value="@OrderStatus.Completed">Completed</MudSelectItem>
                    </MudSelect>
                </Actions>
            </DataGridToolbar>

            @if (_ordersLoading)
            {
                <LoadingState Text="Loading work queue" />
            }
            else if (!string.IsNullOrWhiteSpace(_ordersError))
            {
                <ErrorState Title="Unable to load work queue"
                            Message="@_ordersError"
                            OnRetry="@(() => LoadOrdersAsync(Math.Max(_orders.Page, 1)))" />
            }
            else if (_orders.Items.Count == 0)
            {
                <EmptyState Title="No assigned work"
                            Description="@EmptyOrdersDescription"
                            Icon="@Icons.Material.Outlined.AssignmentLate" />
            }
            else
            {
                <MudTable Items="@_orders.Items" Hover="true" Dense="true" Class="sb-data-table">
                    <HeaderContent>
                        <MudTh>Order Number</MudTh>
                        <MudTh>Customer</MudTh>
                        <MudTh>Service</MudTh>
                        <MudTh>Assigned Time</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Order Number"><strong>@context.OrderNumber</strong></MudTd>
                        <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                        <MudTd DataLabel="Service">@context.ServiceName<span class="sb-table-subtext">@AgentOrderDisplay.VariantLabel(context.PlanName, context.PlanDurationDays, context.PlanRegionCode)</span></MudTd>
                        <MudTd DataLabel="Assigned Time">@(context.AssignedAt.HasValue ? AgentOrderDisplay.FormatDateTime(context.AssignedAt.Value) : "-")</MudTd>
                        <MudTd DataLabel="Status">
                            <StatusBadge Text="@AgentOrderDisplay.OrderStatusLabel(context.Status)"
                                         Tone="@AgentOrderDisplay.OrderTone(context.Status)" />
                            @if (context.HasPendingCustomerAction)
                            {
                                <span class="sb-table-subtext">Requires customer action</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Action">
                            <div class="sb-action-cell">
                                <MudButton Href="@($"/ui/agent/orders/{context.OrderId}")"
                                           Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.OpenInNew">
                                    Workspace
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@(context.Status != nameof(OrderStatus.Assigned) || _actionBusy)"
                                           StartIcon="@Icons.Material.Outlined.PlayArrow"
                                           OnClick="@(() => StartProcessingAsync(context.OrderId))">
                                    Start Processing
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@_actionBusy"
                                           StartIcon="@Icons.Material.Outlined.ContactSupport"
                                           OnClick="@(() => OpenRequestInfoAsync(context.OrderId))">
                                    Request Customer Info
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Disabled="@(context.Status != nameof(OrderStatus.Processing) || _actionBusy)"
                                           StartIcon="@Icons.Material.Outlined.CheckCircle"
                                           OnClick="@(() => CompleteAsync(context.OrderId))">
                                    Complete Order
                                </MudButton>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                @if (_orders.TotalPages > 1)
                {
                    <div class="sb-pagination">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(_orders.Page <= 1 || _ordersLoading)"
                                   StartIcon="@Icons.Material.Outlined.ChevronLeft"
                                   OnClick="PreviousPage">
                            Previous
                        </MudButton>
                        <span>Page @_orders.Page of @_orders.TotalPages</span>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(_orders.Page >= _orders.TotalPages || _ordersLoading)"
                                   EndIcon="@Icons.Material.Outlined.ChevronRight"
                                   OnClick="NextPage">
                            Next
                        </MudButton>
                    </div>
                }
            }
        </section>

        <section class="sb-dashboard-panel">
            <div class="sb-dashboard-panel-header">
                <div>
                    <h2>Recent Activity Feed</h2>
                    <p>Activity derived from the currently loaded work queue.</p>
                </div>
            </div>

            @if (_ordersLoading)
            {
                <LoadingState Text="Loading activity" />
            }
            else if (ActivityItems.Count == 0)
            {
                <EmptyState Title="No recent activity"
                            Description="Assignment and processing activity appears here after work is loaded."
                            Icon="@Icons.Material.Outlined.Timeline" />
            }
            else
            {
                <div class="sb-activity-feed">
                    @foreach (var item in ActivityItems)
                    {
                        <article class="sb-activity-item">
                            <strong>@item.Title</strong>
                            <p>@item.Description</p>
                            <span>@item.Time</span>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</PageSection>

<Drawer @bind-Open="_drawerOpen" Title="@(_selectedOrder?.OrderNumber ?? "Order details")" Eyebrow="Assigned order">
    @if (_detailLoading)
    {
        <LoadingState Text="Loading order details" />
    }
    else if (!string.IsNullOrWhiteSpace(_detailError))
    {
        <ErrorState Title="Unable to load order details"
                    Message="@_detailError" />
    }
    else if (_selectedOrder is not null)
    {
        <div class="sb-note-list">
            <section class="sb-detail-panel">
                <h2>Order Summary</h2>
                <dl class="sb-fact-list">
                    <div><dt>Customer</dt><dd>@_selectedOrder.CustomerName</dd></div>
                    <div><dt>Service</dt><dd>@_selectedOrder.ServiceName</dd></div>
                    <div><dt>Status</dt><dd><StatusBadge Text="@AgentOrderDisplay.OrderStatusLabel(_selectedOrder.Status)" Tone="@AgentOrderDisplay.OrderTone(_selectedOrder.Status)" /></dd></div>
                    <div><dt>Paid amount</dt><dd>@_selectedOrder.FinalPriceIrr.ToString("N0") IRR</dd></div>
                </dl>
            </section>

            <section class="sb-detail-panel">
                <h2>Order Timeline</h2>
                <OrderLifecycle CurrentStatus="@_selectedOrder.Status" />
            </section>

            <section class="sb-detail-panel">
                <h2>Credentials</h2>
                @if (_selectedOrder.Fields.Count == 0)
                {
                    <p>No customer credentials are attached to this order.</p>
                }
                else
                {
                    <dl class="sb-fact-list">
                        @foreach (var field in _selectedOrder.Fields.OrderBy(field => field.DisplayOrder))
                        {
                            <div>
                                <dt>@field.FieldLabel</dt>
                                <dd>@field.Value</dd>
                            </div>
                        }
                    </dl>
                }
            </section>

            <section class="sb-detail-panel">
                <h2>Request Customer Info</h2>
                @if (!string.IsNullOrWhiteSpace(_actionError))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
                }
                <MudTextField T="string"
                              Label="Customer-visible message"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="4"
                              Value="@_customerRequestText"
                              ValueChanged="@((string? value) => _customerRequestText = value ?? string.Empty)" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_actionBusy"
                           StartIcon="@Icons.Material.Outlined.ContactSupport"
                           OnClick="SubmitCustomerRequestAsync">
                    Send Request
                </MudButton>
            </section>
        </div>
    }
</Drawer>

@code {
    private const int PageSize = 20;

    private bool _summaryLoading = true;
    private bool _ordersLoading = true;
    private bool _detailLoading;
    private bool _drawerOpen;
    private bool _actionBusy;
    private string? _summaryError;
    private string? _ordersError;
    private string? _detailError;
    private string? _actionError;
    private string? _search;
    private string _customerRequestText = string.Empty;
    private OrderStatus? _status;
    private AgentOrderDashboardSummaryDto? _summary;
    private PagedResultDto<AgentOrderListItemDto> _orders = new();
    private AgentOrderDetailDto? _selectedOrder;

    private int WaitingCustomerCount =>
        _orders.Items.Count(order => order.HasPendingCustomerAction);

    private string EmptyOrdersDescription => _status.HasValue || !string.IsNullOrWhiteSpace(_search)
        ? "No assigned orders match the current filters."
        : "Assigned work will appear here after an admin assigns paid orders.";

    private IReadOnlyList<ActivityFeedItem> ActivityItems =>
        _orders.Items
            .OrderByDescending(order => order.AssignedAt ?? order.CreatedAt)
            .Take(6)
            .Select(order => new ActivityFeedItem(
                ActivityTitle(order),
                $"{order.OrderNumber} / {order.CustomerName} / {order.ServiceName}",
                AgentOrderDisplay.FormatDateTime(order.AssignedAt ?? order.CreatedAt)))
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        OrderRealtimeClient.OrderUpdated += HandleOrderUpdatedAsync;
        await OrderRealtimeClient.StartAsync();
        await LoadSummaryAsync();
        await LoadOrdersAsync();
    }

    private async Task OnSearchChanged(string? search)
    {
        _search = search;
        await LoadOrdersAsync(1);
    }

    private async Task OnStatusChanged(OrderStatus? status)
    {
        _status = status;
        await LoadOrdersAsync(1);
    }

    private Task PreviousPage()
    {
        return LoadOrdersAsync(Math.Max(_orders.Page - 1, 1));
    }

    private Task NextPage()
    {
        return LoadOrdersAsync(_orders.Page + 1);
    }

    private async Task OpenRequestInfoAsync(Guid orderId)
    {
        _drawerOpen = true;
        _customerRequestText = string.Empty;
        await LoadOrderDetailAsync(orderId);
    }

    private async Task LoadSummaryAsync()
    {
        _summaryLoading = true;
        _summaryError = null;

        var result = await AgentOrdersClient.GetDashboardSummaryAsync();
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        _summary = result.Success ? result.Data : null;
        _summaryError = result.ErrorMessage;
        _summaryLoading = false;
    }

    private async Task LoadOrdersAsync(int page = 1)
    {
        _ordersLoading = true;
        _ordersError = null;

        var result = await AgentOrdersClient.GetOrdersAsync(page, PageSize, _status, _search);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        _orders = result.Success && result.Data is not null
            ? result.Data
            : new PagedResultDto<AgentOrderListItemDto>();
        _ordersError = result.ErrorMessage;
        _ordersLoading = false;
    }

    private async Task LoadOrderDetailAsync(Guid orderId)
    {
        _detailLoading = true;
        _detailError = null;
        _actionError = null;
        _selectedOrder = null;

        var result = await AgentOrdersClient.GetOrderAsync(orderId);
        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        _selectedOrder = result.Success ? result.Data : null;
        _detailError = result.ErrorMessage;
        _detailLoading = false;
    }

    private Task StartProcessingAsync(Guid orderId)
    {
        return RunActionAsync(
            orderId,
            id => AgentOrdersClient.StartProcessingAsync(id, "Processing started from agent dashboard."));
    }

    private Task CompleteAsync(Guid orderId)
    {
        return RunActionAsync(
            orderId,
            id => AgentOrdersClient.CompleteAsync(id, "Completed from agent dashboard."));
    }

    private Task SubmitCustomerRequestAsync()
    {
        if (_selectedOrder is null)
        {
            return Task.CompletedTask;
        }

        if (string.IsNullOrWhiteSpace(_customerRequestText))
        {
            _actionError = "Enter the customer information request before sending.";
            return Task.CompletedTask;
        }

        return RunActionAsync(
            _selectedOrder.OrderId,
            id => AgentOrdersClient.RequestCustomerActionAsync(id, _customerRequestText));
    }

    private async Task RunActionAsync(
        Guid orderId,
        Func<Guid, Task<AgentOrdersApiResult<bool>>> action)
    {
        _actionBusy = true;
        _actionError = null;
        var result = await action(orderId);

        if (result.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (!result.Success)
        {
            _actionError = result.ErrorMessage ?? "Unable to update this order.";
            _actionBusy = false;
            return;
        }

        _customerRequestText = string.Empty;
        await LoadSummaryAsync();
        await LoadOrdersAsync(Math.Max(_orders.Page, 1));
        if (_drawerOpen)
        {
            await LoadOrderDetailAsync(orderId);
        }

        _actionBusy = false;
    }

    private Task HandleOrderUpdatedAsync(OrderUpdatedRealtimeMessage message)
    {
        return InvokeAsync(async () =>
        {
            await LoadSummaryAsync();
            await LoadOrdersAsync(Math.Max(_orders.Page, 1));
            if (_drawerOpen && _selectedOrder is not null)
            {
                await LoadOrderDetailAsync(_selectedOrder.OrderId);
            }

            StateHasChanged();
        });
    }

    private static string ActivityTitle(AgentOrderListItemDto order)
    {
        if (order.HasPendingCustomerAction)
        {
            return "Customer action pending";
        }

        return order.Status switch
        {
            nameof(OrderStatus.Assigned) => "Order assigned",
            nameof(OrderStatus.Processing) => "Order in processing",
            nameof(OrderStatus.Completed) => "Order completed",
            _ => UserOrderDisplay.OrderStatusLabel(order.Status)
        };
    }

    public void Dispose()
    {
        OrderRealtimeClient.OrderUpdated -= HandleOrderUpdatedAsync;
    }

    private sealed record ActivityFeedItem(string Title, string Description, string Time);
}
