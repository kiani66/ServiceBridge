@page "/ui/agent/orders/{OrderId:guid}"
@page "/Agent/Orders/{OrderId:guid}"
@attribute [Authorize(Roles = AppConstants.Roles.Agent)]
@implements IDisposable
@inject AgentOrdersClient AgentOrdersClient
@inject RealtimeClient RealtimeClient
@inject NavigationManager Navigation

@if (_loading)
{
    <PageHeader Eyebrow="Agent workspace"
                Title="Loading order"
                Description="Fetching the assigned order." />
    <PageSection MaxWidth="standard">
        <LoadingState Text="Loading assigned order" />
    </PageSection>
}
else if (_order is null)
{
    <ErrorState Title="Assigned order unavailable"
                Message="@(_errorMessage ?? "The requested assigned order could not be loaded.")"
                Icon="@Icons.Material.Outlined.AssignmentLate"
                OnRetry="RequestOrderReloadAsync">
        <Actions>
            <MudButton Href="/ui/agent" Variant="Variant.Outlined" Color="Color.Primary">Back to workspace</MudButton>
        </Actions>
    </ErrorState>
}
else
{
    <Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Agent", "/ui/agent"), (_order.OrderNumber, null) })" />

    <PageHeader Eyebrow="Assigned order"
                Title="@_order.OrderNumber"
                Description="@($"{_order.CustomerName} / {_order.ServiceName}")">
        <Actions>
            <StatusBadge Text="@AgentOrderDisplay.OrderStatusLabel(_order.Status)"
                         Tone="@AgentOrderDisplay.OrderTone(_order.Status)" />
            <MudButton Href="/ui/agent/orders"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.ArrowBack">
                Orders
            </MudButton>
        </Actions>
    </PageHeader>

    <PageSection MaxWidth="wide">
        <div class="sb-order-management-grid">
            <div class="sb-order-stack">
                @if (!string.IsNullOrWhiteSpace(_actionMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@_actionMessage</MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(_actionError))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_actionError</MudAlert>
                }

                <OrderSummaryCard Title="Assigned order"
                                  Eyebrow="Workspace"
                                  Facts="@SummaryFacts" />

                <CredentialCard Title="Protected credentials"
                                Description="Credential values are intentionally kept behind the protected fulfillment workflow."
                                ProtectedPlaceholder="true"
                                Items="@CredentialItems" />

                @if (_order.DeliveryFields.Count > 0)
                {
                    <section class="sb-detail-panel sb-order-detail-card">
                        <div class="sb-card-heading">
                            <div>
                                <span class="sb-eyebrow">Delivery</span>
                                <h2>Agent delivery credentials</h2>
                                <p>Save the fulfillment data that should be available after completion.</p>
                            </div>
                        </div>

                        <div class="sb-order-form">
                            @foreach (var field in _order.DeliveryFields.OrderBy(field => field.DisplayOrder))
                            {
                                <MudTextField T="string"
                                              Label="@field.FieldLabel"
                                              Variant="Variant.Outlined"
                                              Lines="@(IsTextArea(field) ? 3 : 1)"
                                              InputType="@InputTypeFor(field)"
                                              Required="@field.IsRequired"
                                              MaxLength="2000"
                                              HelperText="@DeliveryHelperText(field)"
                                              Value="@GetDeliveryValue(field.FieldKey)"
                                              ValueChanged="@((string? value) => SetDeliveryValue(field.FieldKey, value))"
                                              Disabled="@_actionBusy" />
                            }

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Disabled="@_actionBusy"
                                       StartIcon="@Icons.Material.Outlined.Save"
                                       OnClick="SaveDeliveryCredentialsAsync">
                                Save delivery credentials
                            </MudButton>
                        </div>
                    </section>
                }

                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Customer action</span>
                            <h2>Customer Response</h2>
                        </div>
                    </div>
                    @if (_order.CustomerActions.Count == 0)
                    {
                        <p>No customer information requests are attached to this order.</p>
                    }
                    else
                    {
                        <div class="sb-note-list">
                            @foreach (var action in _order.CustomerActions.OrderByDescending(action => action.RequestedAt))
                            {
                                <article class="sb-note-item">
                                    <strong>Request message</strong>
                                    <p>@action.RequestText</p>
                                    <span>
                                        @(action.IsResolved ? "Resolved" : "Awaiting customer response")
                                        / @AgentOrderDisplay.FormatDateTime(action.RequestedAt)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(action.CustomerResponse))
                                    {
                                        <strong>Customer response</strong>
                                        <p>@action.CustomerResponse</p>
                                        <span>Response date / @FormatNullable(action.RespondedAt)</span>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>

                <NotesPanel Title="Order notes"
                            EmptyText="No notes have been added yet."
                            Notes="@NoteItems">
                    <Composer>
                        <div class="sb-order-form">
                            <MudTextField T="string"
                                          Label="Add note"
                                          Variant="Variant.Outlined"
                                          Lines="4"
                                          MaxLength="2000"
                                          Value="@_noteText"
                                          ValueChanged="@((string? value) => _noteText = value ?? string.Empty)" />
                            <MudCheckBox T="bool"
                                         Label="Visible to customer"
                                         Value="@_noteVisibleToCustomer"
                                         ValueChanged="@((bool value) => _noteVisibleToCustomer = value)" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_actionBusy"
                                       StartIcon="@Icons.Material.Outlined.NoteAdd"
                                       OnClick="AddNoteAsync">
                                Add note
                            </MudButton>
                        </div>
                    </Composer>
                </NotesPanel>
            </div>

            <aside class="sb-order-side-stack">
                <section class="sb-detail-panel sb-order-detail-card">
                    <div class="sb-card-heading">
                        <div>
                            <span class="sb-eyebrow">Actions</span>
                            <h2>Order operations</h2>
                        </div>
                    </div>

                    <div class="sb-order-action-stack">
                        <MudTextField T="string"
                                       Label="Operation note"
                                       Variant="Variant.Outlined"
                                       Lines="3"
                                      MaxLength="1000"
                                      Value="@_operationNote"
                                      ValueChanged="@((string? value) => _operationNote = value)" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!CanStart || _actionBusy)"
                                   StartIcon="@Icons.Material.Outlined.PlayArrow"
                                   OnClick="StartProcessingAsync">
                            Start processing
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(!CanRequestCustomerInfo || _actionBusy)"
                                   StartIcon="@Icons.Material.Outlined.ContactSupport"
                                   OnClick="@(() => _showInformationRequestForm = !_showInformationRequestForm)">
                            Request Information
                        </MudButton>
                        @if (_showInformationRequestForm)
                        {
                            <div class="sb-order-form">
                                <h3>Information Required</h3>
                                <MudTextField T="string"
                                              Label="Message"
                                              Variant="Variant.Outlined"
                                              Lines="4"
                                              Required="true"
                                              MaxLength="1000"
                                              Value="@_informationRequestMessage"
                                              ValueChanged="@((string? value) => _informationRequestMessage = value ?? string.Empty)" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@_actionBusy"
                                           StartIcon="@Icons.Material.Outlined.Send"
                                           OnClick="SubmitInformationRequestAsync">
                                    Submit
                                </MudButton>
                            </div>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   Disabled="@(!CanComplete || _actionBusy)"
                                   StartIcon="@Icons.Material.Outlined.CheckCircle"
                                   OnClick="CompleteAsync">
                            Complete order
                        </MudButton>
                        <div class="sb-order-form">
                            <MudTextField T="string"
                                          Label="Failure reason"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          MaxLength="1000"
                                          Value="@_failureReason"
                                          ValueChanged="@((string? value) => _failureReason = value ?? string.Empty)" />
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Disabled="@(!CanFail || _actionBusy)"
                                       StartIcon="@Icons.Material.Outlined.ReportProblem"
                                       OnClick="FailAsync">
                                Mark failed
                            </MudButton>
                        </div>
                    </div>
                </section>

                <PaymentCard Payments="@_order.Payments" />

                <PricingSnapshotCard BasePriceUsd="@_order.BasePriceUsdSnapshot"
                                     ExchangeRateIrr="@_order.ExchangeRateSnapshot"
                                     MarginPercent="@_order.MarginSnapshot"
                                     FinalPriceIrr="@_order.FinalPriceIrr" />

                <OrderTimeline CurrentStatus="@_order.Status"
                               Items="@TimelineItems" />
            </aside>
        </div>
    </PageSection>
}

@code {
    private readonly RealtimeSubscriptionCollection _realtimeSubscriptions = new();
    private readonly CancellationTokenSource _lifetimeCts = new();
    private RealtimeRefreshCoordinator? _realtimeRefresh;
    private long _loadGeneration;
    private Guid _requestedOrderId;
    [Parameter] public Guid OrderId { get; set; }

    private bool _disposed;
    private bool _loading = true;
    private bool _actionBusy;
    private bool _noteVisibleToCustomer;
    private string? _errorMessage;
    private string? _actionError;
    private string? _actionMessage;
    private string? _operationNote;
    private string _failureReason = string.Empty;
    private string _informationRequestMessage = string.Empty;
    private string _noteText = string.Empty;
    private bool _showInformationRequestForm;
    private AgentOrderDetailDto? _order;
    private Dictionary<string, string> _deliveryCredentials = new(StringComparer.OrdinalIgnoreCase);

    private bool CanStart => _order?.Status == nameof(OrderStatus.Assigned);
    private bool HasPendingCustomerAction =>
        _order?.CustomerActions.Any(action => !action.IsResolved) == true;
    private bool CanRequestCustomerInfo =>
        _order?.Status == nameof(OrderStatus.Processing) && !HasPendingCustomerAction;
    private bool CanComplete =>
        _order?.Status == nameof(OrderStatus.Processing) && !HasPendingCustomerAction;
    private bool CanFail =>
        _order?.Status == nameof(OrderStatus.Processing);

    private IReadOnlyList<OrderFact> SummaryFacts => _order is null
        ? Array.Empty<OrderFact>()
        : new[]
        {
            new OrderFact("Customer", _order.CustomerName),
            new OrderFact("Email", _order.CustomerEmail),
            new OrderFact("Service", _order.ServiceName),
            new OrderFact("Variant", AgentOrderDisplay.VariantLabel(_order.PlanName, _order.PlanDurationDays, _order.PlanRegionCode)),
            new OrderFact("Provider", _order.Provider),
            new OrderFact("Fulfillment", _order.FulfillmentMode),
            new OrderFact("Status", AgentOrderDisplay.OrderStatusLabel(_order.Status), AgentOrderDisplay.OrderTone(_order.Status)),
            new OrderFact("Created", AgentOrderDisplay.FormatDateTime(_order.CreatedAt)),
            new OrderFact("Paid", FormatNullable(_order.PaidAt)),
            new OrderFact("Assigned", FormatNullable(_order.AssignedAt)),
            new OrderFact("Completed", FormatNullable(_order.CompletedAt))
        };

    private IReadOnlyList<CredentialDisplayItem> CredentialItems => _order is null
        ? Array.Empty<CredentialDisplayItem>()
        : _order.Fields
            .OrderBy(field => field.DisplayOrder)
            .Select(field => new CredentialDisplayItem(
                field.FieldLabel,
                field.Value,
                field.IsSensitive,
                field.IsVisibleToCustomerAfterCompletion))
            .ToArray();

    private IReadOnlyList<NoteDisplayItem> NoteItems => _order is null
        ? Array.Empty<NoteDisplayItem>()
        : _order.Notes
            .OrderByDescending(note => note.CreatedAt)
            .Select(note => new NoteDisplayItem(
                note.Text,
                note.AuthorName,
                AgentOrderDisplay.FormatDateTime(note.CreatedAt),
                note.IsVisibleToCustomer ? "Customer visible" : "Internal"))
            .ToArray();

    private IReadOnlyList<TimelineItem> TimelineItems => _order is null
        ? Array.Empty<TimelineItem>()
        : AgentOrderDisplay.TimelineItems(_order.StatusHistory);

    protected override void OnInitialized()
    {
        _realtimeRefresh = new RealtimeRefreshCoordinator(RunOrderReloadCoreAsync);
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToOrderUpdates(HandleOrderUpdatedAsync));
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToOrderAssignments(HandleOrderAssignedAsync));
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToCustomerActions(HandleCustomerActionChangedAsync));
    }

    protected override async Task OnParametersSetAsync()
    {
        await RequestOrderReloadAsync();
    }

    private Task RequestOrderReloadAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _requestedOrderId = OrderId;
        _loadGeneration++;
        if (!TryApplyRealtimeState(() =>
            {
                _loading = true;
                _errorMessage = null;
                _order = null;
                _deliveryCredentials.Clear();
            }))
        {
            return Task.CompletedTask;
        }

        return _realtimeRefresh?.RunAsync() ?? Task.CompletedTask;
    }

    private Task RunOrderReloadCoreAsync()
    {
        return InvokeAsync(async () =>
        {
            await LoadOrderCoreAsync();
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private async Task LoadOrderCoreAsync()
    {
        var generation = _loadGeneration;
        var orderId = _requestedOrderId;
        try
        {
            var result = await AgentOrdersClient.GetOrderAsync(orderId, _lifetimeCts.Token);
            if (!IsCurrentLoad(generation, orderId))
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                TryApplyCurrentLoad(generation, orderId, () => Navigation.NavigateTo("/Account/Login"));
                return;
            }

            TryApplyCurrentLoad(generation, orderId, () =>
            {
                _order = result.Success ? result.Data : null;
                _errorMessage = result.ErrorMessage;
                InitializeDeliveryCredentials();
                _loading = false;
            });
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
    }

    private Task StartProcessingAsync()
    {
        return RunActionAsync(
            (note, token) => AgentOrdersClient.StartProcessingAsync(OrderId, note, token),
            "Processing started.");
    }

    private Task SubmitInformationRequestAsync()
    {
        return RunActionAsync(
            (_, token) => AgentOrdersClient.RequestCustomerActionAsync(
                OrderId,
                _informationRequestMessage,
                token),
            "Customer information requested.",
            requireNote: true,
            missingNoteMessage: "Enter the requested information message.",
            useInformationRequestMessage: true,
            clearInformationRequestMessage: true);
    }

    private Task CompleteAsync()
    {
        return RunActionAsync(
            (note, token) => AgentOrdersClient.CompleteAsync(OrderId, note, token),
            "Order completed.");
    }

    private Task FailAsync()
    {
        if (string.IsNullOrWhiteSpace(_failureReason))
        {
            _actionError = "Enter the reason the order could not be completed.";
            return Task.CompletedTask;
        }

        return RunActionAsync(
            (_, token) => AgentOrdersClient.FailAsync(OrderId, _failureReason, token),
            "Order marked failed.",
            clearFailureReason: true);
    }

    private Task SaveDeliveryCredentialsAsync()
    {
        if (_order is null)
        {
            return Task.CompletedTask;
        }

        var missingRequiredField = _order.DeliveryFields
            .Where(field => field.IsRequired)
            .FirstOrDefault(field => string.IsNullOrWhiteSpace(GetDeliveryValue(field.FieldKey)));
        if (missingRequiredField is not null)
        {
            _actionError = $"{missingRequiredField.FieldLabel} is required.";
            return Task.CompletedTask;
        }

        return RunActionAsync(
            (_, token) => AgentOrdersClient.SaveDeliveryCredentialsAsync(
                OrderId,
                _deliveryCredentials,
                token),
            "Delivery credentials saved.");
    }

    private Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_noteText))
        {
            _actionError = "Enter a note before saving.";
            return Task.CompletedTask;
        }

        return RunActionAsync(
            (_, token) => AgentOrdersClient.AddNoteAsync(
                OrderId,
                _noteText,
                _noteVisibleToCustomer,
                token),
            "Note added.",
            clearNote: true);
    }

    private async Task RunActionAsync(
        Func<string?, CancellationToken, Task<AgentOrdersApiResult<bool>>> action,
        string successMessage,
        bool requireNote = false,
        string? missingNoteMessage = null,
        bool clearNote = false,
        bool useInformationRequestMessage = false,
        bool clearInformationRequestMessage = false,
        bool clearFailureReason = false)
    {
        if (_disposed || _actionBusy)
        {
            return;
        }

        _actionError = null;
        _actionMessage = null;
        var actionNote = useInformationRequestMessage
            ? _informationRequestMessage
            : _operationNote;

        if (requireNote && string.IsNullOrWhiteSpace(actionNote))
        {
            _actionError = missingNoteMessage ?? "Enter a note before continuing.";
            return;
        }

        _actionBusy = true;
        var orderId = OrderId;
        try
        {
            var result = await action(actionNote, _lifetimeCts.Token);
            if (!CanContinueAction(orderId))
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            if (!result.Success)
            {
                _actionError = result.ErrorMessage ?? "Unable to update this order.";
                _actionBusy = false;
                return;
            }

            if (clearNote)
            {
                _noteText = string.Empty;
                _noteVisibleToCustomer = false;
            }

            if (clearInformationRequestMessage)
            {
                _informationRequestMessage = string.Empty;
                _showInformationRequestForm = false;
            }
            else if (clearFailureReason)
            {
                _failureReason = string.Empty;
            }
            else
            {
                _operationNote = null;
            }

            _actionMessage = successMessage;
            await RequestOrderReloadAsync();
            if (CanContinueAction(orderId))
            {
                _actionBusy = false;
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
    }

    private Task HandleOrderUpdatedAsync(OrderUpdatedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return RequestOrderReloadAsync();
    }

    private Task HandleOrderAssignedAsync(OrderAssignedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return RequestOrderReloadAsync();
    }

    private Task HandleCustomerActionChangedAsync(
        CustomerActionChangedRealtimeDto message)
    {
        if (message.OrderId != OrderId)
        {
            return Task.CompletedTask;
        }

        return RequestOrderReloadAsync();
    }

    private bool IsCurrentLoad(long generation, Guid orderId)
    {
        return !_disposed &&
               generation == _loadGeneration &&
               orderId == _requestedOrderId &&
               orderId == OrderId;
    }

    private bool TryApplyCurrentLoad(long generation, Guid orderId, Action apply)
    {
        return IsCurrentLoad(generation, orderId) && TryApplyRealtimeState(apply);
    }

    private bool CanContinueAction(Guid orderId)
    {
        return !_disposed && orderId == OrderId;
    }

    private bool TryApplyRealtimeState(Action apply)
    {
        return !_disposed &&
               _realtimeRefresh?.TryApply(apply) == true;
    }

    private static string FormatNullable(DateTime? value)
    {
        return value.HasValue ? AgentOrderDisplay.FormatDateTime(value.Value) : "-";
    }

    private void InitializeDeliveryCredentials()
    {
        _deliveryCredentials = _order?.DeliveryFields
            .ToDictionary(
                field => field.FieldKey,
                field => field.Value,
                StringComparer.OrdinalIgnoreCase) ??
            new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    }

    private string GetDeliveryValue(string fieldKey)
    {
        return _deliveryCredentials.TryGetValue(fieldKey, out var value)
            ? value
            : string.Empty;
    }

    private void SetDeliveryValue(string fieldKey, string? value)
    {
        _deliveryCredentials[fieldKey] = value ?? string.Empty;
    }

    private static string DeliveryHelperText(AgentOrderFieldDto field)
    {
        return field.IsVisibleToCustomerAfterCompletion
            ? "Visible to the customer after completion."
            : "Internal delivery field.";
    }

    private static bool IsTextArea(AgentOrderFieldDto field)
    {
        return field.FieldType.Equals("Textarea", StringComparison.OrdinalIgnoreCase);
    }

    private static InputType InputTypeFor(AgentOrderFieldDto field)
    {
        if (IsTextArea(field))
        {
            return InputType.Text;
        }

        if (field.IsSensitive ||
            field.FieldType.Equals("Password", StringComparison.OrdinalIgnoreCase))
        {
            return InputType.Password;
        }

        if (field.FieldType.Equals("Email", StringComparison.OrdinalIgnoreCase))
        {
            return InputType.Email;
        }

        if (field.FieldType.Equals("Number", StringComparison.OrdinalIgnoreCase))
        {
            return InputType.Number;
        }

        return InputType.Text;
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetimeCts.Cancel();
        _realtimeRefresh?.Dispose();
        _realtimeSubscriptions.Dispose();
        _order = null;
        _deliveryCredentials.Clear();
        _lifetimeCts.Dispose();
    }
}
