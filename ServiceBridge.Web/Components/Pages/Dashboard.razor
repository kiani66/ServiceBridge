@page "/ui/dashboard"
@inject ServiceBridgeMockDataProvider MockData

<Breadcrumb Items="@(new List<(string Text, string? Href)> { ("Home", "/ui"), ("Dashboard", null) })" />

<PageHeader Eyebrow="User workspace"
            Title="Dashboard"
            Description="A mock user dashboard focused on payment state, fulfillment progress, and credential attention." />

<PageSection MaxWidth="standard">
    <div class="sb-stat-grid">
        @foreach (var metric in MockData.DashboardMetrics)
        {
            <StatCard Label="@metric.Label" Value="@metric.Value" Description="@metric.Description" Tone="@metric.Tone" Icon="@metric.Icon" />
        }
    </div>
</PageSection>

<PageSection Title="Recent orders" Description="Mock user-facing order summaries." MaxWidth="standard">
    <div class="sb-order-grid">
        @foreach (var order in MockData.Orders.Take(3))
        {
            <OrderCard Order="@order" />
        }
    </div>
</PageSection>

<PageSection Title="Timeline" Description="Recent fulfillment activity from mock order data." MaxWidth="standard">
    <Timeline Items="@MockData.Activity" />
</PageSection>
