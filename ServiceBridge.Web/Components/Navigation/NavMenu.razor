<div class="sb-sidebar-header">
    <div class="sb-brand-mark">SB</div>
    <div>
        <strong>ServiceBridge</strong>
        <span>Operations UI</span>
    </div>
</div>

<MudNavMenu Class="sb-nav-menu">
    <AuthorizeView Roles="@AppConstants.Roles.User">
        <Authorized>
            <MudNavLink Href="/ui" Icon="@Icons.Material.Outlined.Home" Match="NavLinkMatch.All">
                Home
            </MudNavLink>
            <MudNavLink Href="/Services" Icon="@Icons.Material.Outlined.Storefront">
                Public Catalog
            </MudNavLink>
            <MudNavLink Href="/Orders" Icon="@Icons.Material.Outlined.ReceiptLong">
                Orders
            </MudNavLink>
            <MudNavLink Href="/ui/tickets" Icon="@Icons.Material.Outlined.ContactSupport">
                Support
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="@AppConstants.Roles.Agent">
        <Authorized>
            <MudNavLink Href="/ui/agent" Icon="@Icons.Material.Outlined.SupportAgent">
                Agent
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="@AppConstants.Roles.Admin">
        <Authorized>
            <MudNavLink Href="/ui/admin" Icon="@Icons.Material.Outlined.AdminPanelSettings">
                Admin
            </MudNavLink>
            <MudNavLink Href="/ui/admin/tickets" Icon="@Icons.Material.Outlined.ContactSupport">
                Support
            </MudNavLink>
        </Authorized>
