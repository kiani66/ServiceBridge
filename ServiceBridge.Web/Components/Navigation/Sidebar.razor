@using ServiceBridge.Web.Navigation

<div class="sb-sidebar-header">
    <div class="sb-brand-mark">SB</div>
    <div>
        <strong>ServiceBridge</strong>
        <span>Digital service mediation</span>
    </div>
</div>

<MudNavMenu Class="sb-nav-menu">
    <AuthorizeView>
        <Authorized Context="authContext">
            @foreach (var group in RoleNavigation.GetConsoleItems(authContext.User).GroupBy(item => item.Group))
            {
                <MudText Typo="Typo.caption" Class="sb-nav-group">@group.Key</MudText>
                @foreach (var item in group)
                {
                    <MudNavLink Href="@item.Page"
                                Icon="@item.Icon"
                                Match="@GetMatch(item)">
                        @item.Text
                    </MudNavLink>
                }
            }
        </Authorized>
        <NotAuthorized>
            <MudText Typo="Typo.caption" Class="sb-nav-group">Public</MudText>
            <MudNavLink Href="/ui" Icon="@Icons.Material.Outlined.Home" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Href="/ui/catalog" Icon="@Icons.Material.Outlined.Apps">Services</MudNavLink>
            <MudNavLink Href="/ui#faq" Icon="@Icons.Material.Outlined.HelpOutline">FAQ</MudNavLink>
            <MudNavLink Href="/ui#contact" Icon="@Icons.Material.Outlined.MailOutline">Contact Us</MudNavLink>
            <MudNavLink Href="/ui#about" Icon="@Icons.Material.Outlined.Info">About</MudNavLink>
            <MudNavLink Href="/Account/Login" Icon="@Icons.Material.Outlined.Login">Sign in</MudNavLink>
            <MudNavLink Href="/Account/Register" Icon="@Icons.Material.Outlined.PersonAdd">Register</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [Parameter] public string CurrentPath { get; set; } = "/";

    private static NavLinkMatch GetMatch(NavigationItem item)
    {
        return item.MatchExact ? NavLinkMatch.All : NavLinkMatch.Prefix;
    }
}
