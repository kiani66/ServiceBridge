@inject NotificationsClient NotificationsClient
@inject NavigationManager Navigation
@inject RealtimeClient RealtimeClient
@implements IDisposable

<AuthorizeView>
    <Authorized Context="authContext">
        <MudMenu @ref="_menu"
                 Dense="true"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 PopoverClass="sb-notification-menu">
            <ActivatorContent Context="menuContext">
                <MudTooltip Text="Notifications">
                    <MudBadge Content="@_unreadCount"
                              Visible="@(_unreadCount > 0)"
                              Color="Color.Error"
                              Overlap="true"
                              Class="sb-notification-badge">
                        <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                                       Color="Color.Primary"
                                       OnClick="@menuContext.ToggleAsync"
                                       aria-label="Notifications" />
                    </MudBadge>
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <NotificationBellMenu UnreadCount="@_unreadCount"
                                      OnMarkAllAsRead="MarkAllAsReadAsync">
                    @if (_loading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <p class="sb-notification-error">@_errorMessage</p>
                    }
                    else if (_notifications.Count == 0)
                    {
                        <p class="sb-notification-empty">No notifications yet.</p>
                    }
                    else
                    {
                        <div class="sb-notification-list">
                            @foreach (var notification in _notifications)
                            {
                                <NotificationBellItem Notification="@notification"
                                                      Busy="@_busyNotifications.Contains(notification.Id)"
                                                      OnOpen="OpenNotificationAsync"
                                                      OnMarkAsRead="MarkNotificationAsReadAsync" />
                            }
                        </div>
                    }
                </NotificationBellMenu>
            </ChildContent>
        </MudMenu>
    </Authorized>
</AuthorizeView>

@code {
    private readonly RealtimeSubscriptionCollection _realtimeSubscriptions = new();
    private readonly HashSet<Guid> _busyNotifications = new();
    private readonly CancellationTokenSource _lifetimeCts = new();
    private MudMenu? _menu;
    private CoalescingAsyncAction? _refreshAction;
    private bool _disposed;
    private bool _markAllBusy;
    private bool _loading = true;
    private long _mutationVersion;
    private int _unreadCount;
    private string? _errorMessage;
    private IReadOnlyCollection<NotificationDto> _notifications =
        Array.Empty<NotificationDto>();

    protected override async Task OnInitializedAsync()
    {
        _refreshAction = new CoalescingAsyncAction(RefreshCoreAsync);
        _realtimeSubscriptions.Add(RealtimeClient.SubscribeToNotifications(HandleNotificationReceivedAsync));
        await RefreshAsync();
    }

    private Task RefreshAsync()
    {
        return _refreshAction?.RequestAsync() ?? Task.CompletedTask;
    }

    private async Task RefreshCoreAsync()
    {
        if (_disposed)
        {
            return;
        }

        var mutationVersion = _mutationVersion;
        _loading = true;
        _errorMessage = null;

        NotificationsApiResult<UnreadNotificationCountDto> countResult;
        NotificationsApiResult<PagedResultDto<NotificationDto>> notificationsResult;
        try
        {
            countResult = await NotificationsClient.GetUnreadCountAsync(_lifetimeCts.Token);
            notificationsResult = await NotificationsClient.GetNotificationsAsync(
                page: 1,
                pageSize: 5,
                cancellationToken: _lifetimeCts.Token);
        }
        catch (OperationCanceledException) when (_disposed)
        {
            return;
        }

        if (_disposed)
        {
            return;
        }

        if (countResult.RequiresAuthentication ||
            notificationsResult.RequiresAuthentication)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        if (mutationVersion != _mutationVersion)
        {
            _ = RefreshAsync();
            return;
        }

        if (!countResult.Success)
        {
            _errorMessage = countResult.ErrorMessage;
        }
        else
        {
            _unreadCount = countResult.Data?.Count ?? 0;
        }

        if (!notificationsResult.Success)
        {
            _errorMessage = notificationsResult.ErrorMessage;
        }
        else
        {
            _notifications = (notificationsResult.Data?.Items ??
                    Array.Empty<NotificationDto>())
                .DistinctBy(notification => notification.Id)
                .ToArray();
        }

        _loading = false;
    }

    internal async Task OpenNotificationAsync(NotificationDto notification)
    {
        if (_disposed || !_busyNotifications.Add(notification.Id))
        {
            return;
        }

        try
        {
            var wasUnread = !notification.IsRead;
            var preparation = await NotificationNavigation.PrepareOpenAsync(
                notification,
                CloseMenuAsync,
                id => NotificationsClient.MarkAsReadAsync(id, _lifetimeCts.Token),
                () => !_disposed);
            if (_disposed)
            {
                return;
            }

            if (wasUnread && preparation.MarkedAsRead)
            {
                ApplyReadMutation(notification.Id);
            }

            if (wasUnread)
            {
                QueueAuthoritativeRefresh();
            }

            if (preparation.Route is not null)
            {
                Navigation.NavigateTo(preparation.Route);
            }
        }
        finally
        {
            if (!_disposed)
            {
                _busyNotifications.Remove(notification.Id);
            }
        }
    }

    private async Task MarkNotificationAsReadAsync(NotificationDto notification)
    {
        if (_disposed || !_busyNotifications.Add(notification.Id))
        {
            return;
        }

        try
        {
            var result = await NotificationsClient.MarkAsReadAsync(
                notification.Id,
                _lifetimeCts.Token);
            if (_disposed)
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            if (result.Success)
            {
                ApplyReadMutation(notification.Id);
            }

            QueueAuthoritativeRefresh();
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            if (!_disposed)
            {
                _busyNotifications.Remove(notification.Id);
            }
        }
    }

    private Task CloseMenuAsync()
    {
        return _menu?.CloseMenuAsync() ?? Task.CompletedTask;
    }

    private async Task MarkAllAsReadAsync()
    {
        if (_disposed || _markAllBusy)
        {
            return;
        }

        _markAllBusy = true;
        try
        {
            var result = await NotificationsClient.MarkAllAsReadAsync(_lifetimeCts.Token);
            if (_disposed)
            {
                return;
            }

            if (result.RequiresAuthentication)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            if (result.Success)
            {
                ApplyMarkAllMutation();
            }

            QueueAuthoritativeRefresh();
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            if (!_disposed)
            {
                _markAllBusy = false;
            }
        }
    }

    private Task HandleNotificationReceivedAsync(RealtimeEventDto notification)
    {
        return InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            if (notification.UnreadCount.HasValue)
            {
                _mutationVersion++;
                _unreadCount = Math.Max(0, notification.UnreadCount.Value);
            }

            await RefreshAsync();
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void ApplyReadMutation(Guid notificationId)
    {
        _mutationVersion++;
        var current = _notifications.FirstOrDefault(item => item.Id == notificationId);
        if (current is null || current.IsRead)
        {
            return;
        }

        current.IsRead = true;
        _unreadCount = Math.Max(0, _unreadCount - 1);
    }

    private void ApplyMarkAllMutation()
    {
        _mutationVersion++;
        foreach (var notification in _notifications)
        {
            notification.IsRead = true;
        }

        _unreadCount = 0;
    }

    private void QueueAuthoritativeRefresh()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetimeCts.Cancel();
        _refreshAction?.Dispose();
        _realtimeSubscriptions.Dispose();
        _lifetimeCts.Dispose();
    }
}
