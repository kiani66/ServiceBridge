@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@inject RealtimeClient RealtimeClient

<MudMenu Dense="true"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         PopoverClass="sb-profile-menu-popover">
    <ActivatorContent Context="menuContext">
        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   Class="sb-profile-chip"
                   StartIcon="@Icons.Material.Outlined.AccountCircle"
                   EndIcon="@Icons.Material.Outlined.KeyboardArrowDown"
                   OnClick="@menuContext.ToggleAsync"
                   aria-label="Open account menu"
                   title="Account menu">
            @GetDisplayName(User)
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        <div class="sb-profile-menu">
            <div class="sb-profile-menu-header">
                <strong>@GetDisplayName(User)</strong>
                <span>@GetRole(User)</span>
            </div>
            <MudDivider />
            <MudMenuItem Href="/ui/profile"
                         Icon="@Icons.Material.Outlined.Person">
                Profile
            </MudMenuItem>
            <MudDivider />
            <button type="button"
                    class="sb-profile-menu-action"
                    disabled="@_logoutBusy"
                    @onclick="LogoutAsync">
                <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                <span>Log out</span>
            </button>
        </div>
    </ChildContent>
</MudMenu>

<form @ref="_logoutForm" method="post" action="/Account/Logout" hidden>
    <AntiforgeryToken />
</form>

@code {
    [Parameter, EditorRequired] public System.Security.Claims.ClaimsPrincipal User { get; set; } = default!;

    private ElementReference _logoutForm;
    private bool _logoutBusy;

    private async Task LogoutAsync()
    {
        if (_logoutBusy)
        {
            return;
        }

        _logoutBusy = true;
        try
        {
            await RealtimeClient.StopAsync();
        }
        catch
        {
            // Logout must continue even when the realtime connection cannot stop cleanly.
        }
        finally
        {
            await JS.InvokeVoidAsync("serviceBridgeSubmitForm", _logoutForm);
        }
    }

    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var fullName = user.FindFirst("FullName")?.Value;
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return user.Identity?.Name ?? "Profile";
    }

    private static string GetRole(System.Security.Claims.ClaimsPrincipal user)
    {
        var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ??
            user.FindFirst("role")?.Value;

        return string.IsNullOrWhiteSpace(role) ? "Authenticated" : role;
    }
}
