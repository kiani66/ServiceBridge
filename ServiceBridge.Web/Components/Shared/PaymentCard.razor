@using ServiceBridge.Application.DTOs

<section class="sb-detail-panel sb-order-detail-card">
    <div class="sb-card-heading">
        <div>
            <span class="sb-eyebrow">Payment</span>
            <h2>@Title</h2>
        </div>
        @if (LatestPayment is not null)
        {
            <StatusBadge Text="@UserOrderDisplay.PaymentStatusLabel(LatestPayment.Status)"
                         Tone="@UserOrderDisplay.PaymentTone(LatestPayment.Status)" />
        }
    </div>

    @if (Payments.Count == 0)
    {
        <p>No payment attempts are recorded for this order.</p>
    }
    else
    {
        <dl class="sb-fact-list">
            <div><dt>Latest amount</dt><dd>@LatestPayment!.AmountIrr.ToString("N0") IRR</dd></div>
            <div><dt>Created</dt><dd>@UserOrderDisplay.FormatDateTime(LatestPayment.CreatedAt)</dd></div>
            <div><dt>Completed</dt><dd>@(LatestPayment.CompletedAt.HasValue ? UserOrderDisplay.FormatDateTime(LatestPayment.CompletedAt.Value) : "-")</dd></div>
            <div><dt>Gateway reference</dt><dd>@(LatestPayment.GatewayReference ?? "-")</dd></div>
            <div><dt>Attempts</dt><dd>@Payments.Count.ToString("N0")</dd></div>
        </dl>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "Payment status";
    [Parameter, EditorRequired] public IReadOnlyCollection<PaymentHistoryDto> Payments { get; set; } =
        Array.Empty<PaymentHistoryDto>();

    private PaymentHistoryDto? LatestPayment =>
        Payments
            .OrderByDescending(payment => payment.CreatedAt)
            .ThenByDescending(payment => payment.PaymentId)
            .FirstOrDefault();
}
