<ol class="sb-timeline" aria-label="@AriaLabel">
    @foreach (var item in Items)
    {
        <li>
            <span class="sb-timeline-dot sb-status-@item.Tone"></span>
            <div>
                <strong>@item.Title</strong>
                <p>@item.Description</p>
                <time>@item.Time</time>
            </div>
        </li>
    }
</ol>

@code {
    [Parameter] public string AriaLabel { get; set; } = "Timeline";
    [Parameter, EditorRequired] public IReadOnlyList<TimelineItem> Items { get; set; } = [];
}
