<div class="sb-credential-form">
    @if (Fields.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            This service does not require customer credential fields for the selected fulfillment mode.
        </MudAlert>
    }
    else
    {
        @foreach (var field in Fields.OrderBy(field => field.DisplayOrder))
        {
            <div>
                @if (IsSelect(field))
                {
                    @if (field.Options.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                            Options are not configured for @field.Label.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSelect T="string"
                                   Label="@field.Label"
                                   Variant="Variant.Outlined"
                                   FullWidth="true"
                                   Dense="true"
                                   Required="@field.IsRequired"
                                   RequiredError="@RequiredMessage(field)"
                                   Value="@GetValue(field.FieldKey)"
                                   ValueChanged="@((string value) => OnValueChangedAsync(field.FieldKey, value))"
                                   Error="@HasError(field.FieldKey)"
                                   ErrorText="@GetErrorText(field.FieldKey)"
                                   Disabled="@Disabled">
                            @foreach (var option in field.Options)
                            {
                                <MudSelectItem T="string" Value="@option.Value">
                                    @option.Label
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                }
                else if (IsTextArea(field))
                {
                    <MudTextField T="string"
                                  Label="@field.Label"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Lines="4"
                                  MaxLength="2000"
                                  Required="@field.IsRequired"
                                  RequiredError="@RequiredMessage(field)"
                                  HelperText="@HelperText(field)"
                                  Value="@GetValue(field.FieldKey)"
                                  ValueChanged="@((string value) => OnValueChangedAsync(field.FieldKey, value))"
                                  Error="@HasError(field.FieldKey)"
                                  ErrorText="@GetErrorText(field.FieldKey)"
                                  Disabled="@Disabled"
                                  Immediate="true" />
                }
                else
                {
                    <MudTextField T="string"
                                  Label="@field.Label"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  InputType="@InputTypeFor(field)"
                                  MaxLength="2000"
                                  Required="@field.IsRequired"
                                  RequiredError="@RequiredMessage(field)"
                                  HelperText="@HelperText(field)"
                                  Value="@GetValue(field.FieldKey)"
                                  ValueChanged="@((string value) => OnValueChangedAsync(field.FieldKey, value))"
                                  Error="@HasError(field.FieldKey)"
                                  ErrorText="@GetErrorText(field.FieldKey)"
                                  Disabled="@Disabled"
                                  Immediate="true" />
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<PublicRequiredField> Fields { get; set; } = [];
    [Parameter] public IDictionary<string, string> Values { get; set; } =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public IReadOnlyDictionary<string, string[]> ValidationErrors { get; set; } =
        new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> FieldChanged { get; set; }

    private async Task OnValueChangedAsync(string fieldKey, string? value)
    {
        Values[fieldKey] = value ?? string.Empty;
        await FieldChanged.InvokeAsync(fieldKey);
    }

    private string GetValue(string fieldKey)
    {
        return Values.TryGetValue(fieldKey, out var value)
            ? value
            : string.Empty;
    }

    private bool HasError(string fieldKey)
    {
        return ValidationErrors.TryGetValue(fieldKey, out var errors) &&
            errors.Length > 0;
    }

    private string? GetErrorText(string fieldKey)
    {
        return ValidationErrors.TryGetValue(fieldKey, out var errors)
            ? string.Join(" ", errors)
            : null;
    }

    private static string RequiredMessage(PublicRequiredField field)
    {
        return $"{field.Label} is required.";
    }

    private static string? HelperText(PublicRequiredField field)
    {
        return field.IsSensitive
            ? "This value is treated as sensitive fulfillment data."
            : null;
    }

    private static bool IsSelect(PublicRequiredField field)
    {
        return field.FieldType.Equals("Select", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsTextArea(PublicRequiredField field)
    {
        return field.FieldType.Equals("Textarea", StringComparison.OrdinalIgnoreCase);
    }

    private static InputType InputTypeFor(PublicRequiredField field)
    {
        if (field.IsSensitive ||
            field.FieldType.Equals("Password", StringComparison.OrdinalIgnoreCase))
        {
            return InputType.Password;
        }

        if (field.FieldType.Equals("Email", StringComparison.OrdinalIgnoreCase))
        {
            return InputType.Email;
        }

        if (field.FieldType.Equals("Number", StringComparison.OrdinalIgnoreCase))
        {
            return InputType.Number;
        }

        return InputType.Text;
    }
}
