<div class="sb-credential-form">
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
        Credential fields are shown with mock values only. Future integration must encrypt sensitive values before persistence.
    </MudAlert>
    <MudTextField T="string" Label="Account email" Variant="Variant.Outlined" FullWidth="true" Value="@("customer@example.com")" />
    <MudTextField T="string" Label="Account password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" Value="@("mock-password")" />
    <MudTextField T="string" Label="Recovery contact" Variant="Variant.Outlined" FullWidth="true" Value="@("+98 900 000 0000")" />
</div>
