<ol class="sb-lifecycle" aria-label="Order progress">
    @foreach (var stage in Stages)
    {
        <li class="@StageClass(stage)"
            aria-current="@(stage.State == OrderProgressStageState.Current ? "step" : null)"
            aria-label="@StageAriaLabel(stage)">
            <span class="sb-lifecycle-marker" aria-hidden="true">
                <MudIcon Icon="@StageIcon(stage)" Size="Size.Small" />
            </span>
            <strong>@stage.Label</strong>
            @if (stage.State == OrderProgressStageState.Current)
            {
                <span class="sb-lifecycle-current-label">Current</span>
            }
        </li>
    }
</ol>

@code {
    [Parameter] public string CurrentStatus { get; set; } = nameof(OrderStatus.Created);

    private IReadOnlyList<OrderProgressStage> Stages => OrderProgress.For(CurrentStatus);

    private static string StageClass(OrderProgressStage stage)
    {
        return $"sb-lifecycle-item sb-lifecycle-{stage.State.ToString().ToLowerInvariant()} sb-lifecycle-tone-{stage.Tone}";
    }

    private static string StageAriaLabel(OrderProgressStage stage)
    {
        var state = stage.State switch
        {
            OrderProgressStageState.Complete => "completed step",
            OrderProgressStageState.Current => "current step",
            _ => "upcoming step"
        };

        return $"{stage.Label}, {state}";
    }

    private static string StageIcon(OrderProgressStage stage)
    {
        if (stage.State == OrderProgressStageState.Complete)
        {
            return Icons.Material.Outlined.Check;
        }

        return stage.Status switch
        {
            nameof(OrderStatus.Created) => Icons.Material.Outlined.AddCircleOutline,
            nameof(OrderStatus.WaitingForPayment) => Icons.Material.Outlined.Schedule,
            nameof(OrderStatus.Paid) => Icons.Material.Outlined.Payments,
            nameof(OrderStatus.Assigned) => Icons.Material.Outlined.AssignmentInd,
            nameof(OrderStatus.Processing) => Icons.Material.Outlined.ManageHistory,
            nameof(OrderStatus.Completed) => Icons.Material.Outlined.CheckCircle,
            nameof(OrderStatus.Cancelled) => Icons.Material.Outlined.Cancel,
            nameof(OrderStatus.Failed) => Icons.Material.Outlined.ErrorOutline,
            _ => Icons.Material.Outlined.RadioButtonChecked
        };
    }
}
