<div class="sb-grid-toolbar">
    <div>
        <h2>@Title</h2>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
    </div>
    <div class="sb-grid-toolbar-actions">
        @if (ShowSearch)
        {
            <SearchBar Value="@Search" ValueChanged="@SearchChanged" Placeholder="@SearchPlaceholder" Compact="true" />
        }
        @Actions
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Data";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Search { get; set; }
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "Search rows";
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public RenderFragment? Actions { get; set; }
}
