<article class="sb-stat-card">
    <div class="sb-stat-icon sb-stat-@Tone">
        <MudIcon Icon="@Icon" Size="Size.Medium" />
    </div>
    <div>
        <span>@Label</span>
        <strong>@Value</strong>
        <p>@Description</p>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Analytics;
}
