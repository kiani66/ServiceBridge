<section class="sb-detail-panel sb-order-detail-card">
    <div class="sb-card-heading">
        <div>
            <span class="sb-eyebrow">Timeline</span>
            <h2>@Title</h2>
        </div>
    </div>

    @if (ShowLifecycle)
    {
        <OrderLifecycle CurrentStatus="@CurrentStatus" />
    }

    @if (Items.Count == 0)
    {
        <p>No timeline entries have been recorded yet.</p>
    }
    else
    {
        <Timeline Items="@Items" />
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "Order timeline";
    [Parameter] public string CurrentStatus { get; set; } = nameof(OrderStatus.Created);
    [Parameter] public bool ShowLifecycle { get; set; } = true;
    [Parameter, EditorRequired] public IReadOnlyList<TimelineItem> Items { get; set; } = [];
}
