<section class="sb-detail-panel sb-order-detail-card sb-order-progress-card">
    <div class="sb-card-heading">
        <div>
            <span class="sb-eyebrow">Lifecycle summary</span>
            <h2>Order progress</h2>
        </div>
    </div>

    <OrderLifecycle CurrentStatus="@CurrentStatus" />
</section>

<section class="sb-detail-panel sb-order-detail-card sb-activity-history-card">
    <div class="sb-card-heading">
        <div>
            <span class="sb-eyebrow">Event log</span>
            <h2>Activity history</h2>
        </div>
    </div>

    @if (Items.Count == 0)
    {
        <p>No activity entries have been recorded yet.</p>
    }
    else
    {
        <Timeline Items="@Items" AriaLabel="Activity history" />
    }
</section>

@code {
    [Parameter] public string CurrentStatus { get; set; } = nameof(OrderStatus.Created);
    [Parameter, EditorRequired] public IReadOnlyList<TimelineItem> Items { get; set; } = [];
}
