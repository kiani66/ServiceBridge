<header class="sb-page-header @MaxWidthClass">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="sb-eyebrow">@Eyebrow</span>
        }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="sb-page-actions">
            @Actions
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string MaxWidth { get; set; } = "standard";
    [Parameter] public RenderFragment? Actions { get; set; }

    private string MaxWidthClass => $"sb-page-width-{MaxWidth}";
}

