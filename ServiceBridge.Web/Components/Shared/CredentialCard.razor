<section class="sb-detail-panel sb-order-detail-card">
    <div class="sb-card-heading">
        <div>
            <span class="sb-eyebrow">@Eyebrow</span>
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>
    </div>

    @if (ProtectedPlaceholder)
    {
        <div class="sb-protected-panel">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" />
            <div>
                <strong>Protected credential area</strong>
                <p>@ProtectedMessage</p>
            </div>
        </div>
    }

    @if (Items.Count == 0)
    {
        <p>@EmptyText</p>
    }
    else
    {
        <dl class="sb-fact-list">
            @foreach (var item in Items)
            {
                <div>
                    <dt>
                        @item.Label
                        @if (item.IsSensitive)
                        {
                            <span class="sb-inline-tag">Sensitive</span>
                        }
                    </dt>
                    <dd>@DisplayValue(item)</dd>
                </div>
            }
        </dl>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "Credentials";
    [Parameter] public string Eyebrow { get; set; } = "Credentials";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No credential fields are attached to this order.";
    [Parameter] public bool RevealValues { get; set; }
    [Parameter] public bool ProtectedPlaceholder { get; set; }
    [Parameter] public string ProtectedMessage { get; set; } =
        "Credential reveal and delivery editing are intentionally handled by protected operations.";
    [Parameter, EditorRequired] public IReadOnlyList<CredentialDisplayItem> Items { get; set; } = [];

    private string DisplayValue(CredentialDisplayItem item)
    {
        if (ProtectedPlaceholder)
        {
            return item.IsSensitive ? "Protected" : "Available in protected workflow";
        }

        if (!RevealValues)
        {
            return item.IsSensitive ? "Sensitive value hidden" : "Provided";
        }

        return string.IsNullOrWhiteSpace(item.Value) ? "-" : item.Value;
    }
}
