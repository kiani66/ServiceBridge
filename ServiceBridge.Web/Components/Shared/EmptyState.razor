<section class="sb-empty-state">
    <MudIcon Icon="@Icon" Color="Color.Primary" Size="Size.Large" />
    <h2>@Title</h2>
    <p>@Description</p>
    @if (Actions is not null || !string.IsNullOrWhiteSpace(ActionText))
    {
        <div class="sb-empty-actions">
            @Actions
            @if (!string.IsNullOrWhiteSpace(ActionText))
            {
                <MudButton Href="@ActionHref"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@ActionIcon"
                           OnClick="OnAction">
                    @ActionText
                </MudButton>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Inbox;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string? ActionHref { get; set; }
    [Parameter] public string ActionIcon { get; set; } = Icons.Material.Outlined.ArrowForward;
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}

