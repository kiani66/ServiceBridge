<section class="sb-detail-panel sb-order-detail-card">
    <div class="sb-card-heading">
        <div>
            <span class="sb-eyebrow">Pricing</span>
            <h2>@Title</h2>
        </div>
    </div>

    <dl class="sb-fact-list">
        <div><dt>Foreign price</dt><dd>@BasePriceUsd.ToString("0.##") USD</dd></div>
        <div><dt>Exchange rate</dt><dd>@ExchangeRateIrr.ToString("N0") IRR</dd></div>
        <div><dt>Margin</dt><dd>@MarginPercent.ToString("0.##")%</dd></div>
        <div><dt>Final price</dt><dd>@FinalPriceIrr.ToString("N0") IRR</dd></div>
    </dl>
</section>

@code {
    [Parameter] public string Title { get; set; } = "Pricing snapshot";
    [Parameter] public decimal BasePriceUsd { get; set; }
    [Parameter] public decimal ExchangeRateIrr { get; set; }
    [Parameter] public decimal MarginPercent { get; set; }
    [Parameter] public decimal FinalPriceIrr { get; set; }
}
