@if (Open)
{
    <div class="sb-dialog-backdrop" role="presentation">
        <section class="sb-confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmation-title">
            <h2 id="confirmation-title">@Title</h2>
            <p>@Description</p>
            <div class="sb-dialog-actions">
                <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="@IsBusy" OnClick="CancelAsync">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="@Color" Disabled="@IsBusy" OnClick="ConfirmAsync">@ConfirmText</MudButton>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm action";
    [Parameter] public string Description { get; set; } = "Confirm that you want to continue.";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public bool IsBusy { get; set; }

    private Task CancelAsync()
    {
        if (IsBusy)
        {
            return Task.CompletedTask;
        }

        return OpenChanged.InvokeAsync(false);
    }

    private async Task ConfirmAsync()
    {
        if (IsBusy)
        {
            return;
        }

        await OnConfirmed.InvokeAsync();
        if (!IsBusy)
        {
            await OpenChanged.InvokeAsync(false);
        }
    }
}
