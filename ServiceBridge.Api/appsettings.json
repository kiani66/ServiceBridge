{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Microsoft.EntityFrameworkCore":  "Warning",
                                     "ServiceBridge":  "Information"
                                 },
                    "Console":  {
                                    "IncludeScopes":  true,
                                    "TimestampFormat":  "yyyy-MM-dd HH:mm:ss.fff "
                                }
                },
    "AllowedHosts":  "*",
